---
/* DesktopMockup.astro - Interaktiver Niri / Noctalia Desktop */
---

<div class="relative w-full rounded-2xl border border-white/10 bg-[#070a12] shadow-2xl overflow-hidden font-sans group transition-all duration-300">
    
    <!-- NOCTALIA TOP BAR -->
    <div class="w-full h-9 bg-[#04060c]/90 border-b border-white/10 px-4 flex items-center justify-between font-mono text-xs text-slate-300 select-none">
        
        <!-- Workspaces (Klickbar!) -->
        <div class="flex items-center gap-1.5">
            <button data-ws="1" class="ws-btn px-2.5 py-0.5 rounded bg-[#00b0f0] text-slate-950 font-bold text-xs transition-all cursor-pointer">1</button>
            <button data-ws="2" class="ws-btn px-2.5 py-0.5 rounded bg-white/5 text-slate-400 hover:text-white transition-all cursor-pointer">2</button>
            <button data-ws="3" class="ws-btn px-2.5 py-0.5 rounded bg-white/5 text-slate-400 hover:text-white transition-all cursor-pointer">3</button>
            <button data-ws="4" class="ws-btn px-2.5 py-0.5 rounded bg-white/5 text-slate-400 hover:text-white transition-all cursor-pointer">4</button>
        </div>

        <!-- Dynamic Title -->
        <div class="flex items-center gap-2">
            <img src="/new_favicon.png" alt="VeloxOS" class="h-4 w-auto" />
            <span id="activeAppTitle" class="text-slate-200 font-semibold tracking-wider text-xs">kitty // fastfetch</span>
        </div>

        <!-- Status Tray -->
        <div class="flex items-center gap-3 text-slate-400 text-xs">
            <div class="flex items-center gap-1.5 text-[#00b0f0]">
                <span class="w-2 h-2 rounded-full bg-[#00b0f0] animate-pulse"></span>
                <span>NIRI</span>
            </div>
            <span>US</span>
            <span class="text-slate-200 font-medium">14:32</span>
        </div>
    </div>

    <!-- WORKSPACE CONTAINER (Höhe leicht angehoben & breiter) -->
    <div class="p-4 min-h-[380px] bg-[#070a12] relative overflow-hidden flex flex-col justify-center">
        
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(0,176,240,0.06),transparent_70%)] pointer-events-none"></div>

        <!-- WS 1: Fastfetch + Performance Monitor -->
        <div id="ws-content-1" class="ws-pane grid grid-cols-1 md:grid-cols-12 gap-3 relative z-10">
            <!-- Window 1: Terminal -->
            <div class="md:col-span-7 bg-[#090d16]/95 rounded-xl border border-[#00b0f0]/30 shadow-lg p-4 font-mono text-xs text-slate-200 flex flex-col justify-between">
                <div class="flex items-center justify-between pb-2 mb-2 border-b border-white/5 text-[10px] text-slate-500">
                    <span class="text-[#00b0f0]">veloxos@arch-niri:~</span>
                    <span>kitty</span>
                </div>
                <div class="space-y-2 relative z-10">
                    <div class="flex items-start gap-3">
                        <img src="/new_favicon.png" alt="VeloxOS" class="h-9 w-auto drop-shadow-[0_0_8px_rgba(0,176,240,0.5)] pt-1" />
                        <div class="space-y-0.5 text-[11px]">
                            <p><span class="text-[#00b0f0] font-bold">veloxos</span><span class="text-slate-500">@</span><span class="text-white font-bold">vanilla-arch</span></p>
                            <p class="text-slate-600">------------------</p>
                            <p><span class="text-[#00b0f0]">OS:</span> VeloxOS (Vanilla Arch Base)</p>
                            <p><span class="text-[#00b0f0]">Kernel:</span> Linux 6.14.x-veloxos</p>
                            <p><span class="text-[#00b0f0]">WM:</span> Niri (Scrollable Wayland)</p>
                            <p><span class="text-[#00b0f0]">Shell:</span> Noctalia Shell / Fish</p>
                            <p><span class="text-[#00b0f0]">Terminal:</span> Kitty</p>
                        </div>
                    </div>
                </div>
                <div class="pt-3 text-[11px] flex items-center gap-2 text-slate-400">
                    <span class="text-[#00b0f0]">❯</span>
                    <span class="text-slate-200">veloxos-pkg --check-updates</span>
                    <span class="w-1.5 h-3 bg-[#00b0f0] animate-pulse"></span>
                </div>
            </div>

            <!-- Window 2: Monitor -->
            <div class="md:col-span-5 bg-[#090d16]/80 rounded-xl border border-white/10 p-4 font-mono text-xs flex flex-col justify-between">
                <div class="flex items-center justify-between pb-2 mb-2 border-b border-white/5 text-[10px] text-slate-500">
                    <span>performance // monitor</span>
                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                </div>
                <div class="space-y-3">
                    <div>
                        <div class="flex justify-between text-[11px] mb-1">
                            <span class="text-slate-400">CPU Usage</span>
                            <span class="text-[#00b0f0] font-bold">1.8 %</span>
                        </div>
                        <div class="w-full bg-white/5 h-1.5 rounded-full overflow-hidden">
                            <div class="bg-[#00b0f0] h-full w-[10%] rounded-full"></div>
                        </div>
                    </div>
                    <div>
                        <div class="flex justify-between text-[11px] mb-1">
                            <span class="text-slate-400">RAM (Low-Latency)</span>
                            <span class="text-[#00b0f0] font-bold">1.1 / 32 GB</span>
                        </div>
                        <div class="w-full bg-white/5 h-1.5 rounded-full overflow-hidden">
                            <div class="bg-blue-500 h-full w-[15%] rounded-full"></div>
                        </div>
                    </div>
                </div>
                <div class="pt-2 text-right">
                    <span class="text-[9px] text-slate-500 font-bold uppercase tracking-widest bg-white/5 px-2 py-1 rounded">Wayland Native</span>
                </div>
            </div>
        </div>

        <!-- WS 2: Logo Showcase -->
        <div id="ws-content-2" class="ws-pane hidden flex-col items-center justify-center py-8 relative z-10">
            <img src="https://wiki.veloxos.org/_astro/new_logo.CxzxC9pm_2vCcGx.webp" alt="VeloxOS Emblem" class="h-28 w-auto object-contain drop-shadow-[0_0_25px_rgba(0,176,240,0.4)] animate-pulse" />
            <span class="font-mono text-xs text-slate-400 mt-4 tracking-[0.3em] uppercase">VeloxOS Desktop Architecture</span>
        </div>

        <!-- WS 3: Nautilus File Explorer -->
        <div id="ws-content-3" class="ws-pane hidden bg-[#090d16]/95 rounded-xl border border-white/10 p-4 font-sans relative z-10">
            <!-- Nautilus Header -->
            <div class="flex items-center justify-between pb-3 border-b border-white/10 text-xs text-slate-400 font-mono">
                <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-red-500/80"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/80"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-green-500/80"></span>
                    <span class="ml-2 text-slate-200">Files — /home/veloxos</span>
                </div>
                <span>Nautilus</span>
            </div>
            <!-- File Grid -->
            <div class="grid grid-cols-4 gap-4 pt-5 pb-2 text-center text-xs font-medium text-slate-300">
                <div class="p-3 rounded-lg bg-white/[0.02] border border-white/5 hover:border-[#00b0f0]/50 transition-colors flex flex-col items-center gap-2 cursor-pointer">
                    <svg width="28" height="28" fill="none" stroke="#00b0f0" stroke-width="1.5" viewBox="0 0 24 24"><path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path></svg>
                    <span>Dokumente</span>
                </div>
                <div class="p-3 rounded-lg bg-white/[0.02] border border-white/5 hover:border-[#00b0f0]/50 transition-colors flex flex-col items-center gap-2 cursor-pointer">
                    <svg width="28" height="28" fill="none" stroke="#00b0f0" stroke-width="1.5" viewBox="0 0 24 24"><path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    <span>Bilder</span>
                </div>
                <div class="p-3 rounded-lg bg-white/[0.02] border border-white/5 hover:border-[#00b0f0]/50 transition-colors flex flex-col items-center gap-2 cursor-pointer">
                    <svg width="28" height="28" fill="none" stroke="#00b0f0" stroke-width="1.5" viewBox="0 0 24 24"><path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                    <span>Downloads</span>
                </div>
                <div class="p-3 rounded-lg bg-white/[0.02] border border-white/5 hover:border-[#00b0f0]/50 transition-colors flex flex-col items-center gap-2 cursor-pointer">
                    <svg width="28" height="28" fill="none" stroke="#00b0f0" stroke-width="1.5" viewBox="0 0 24 24"><path d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
                    <span>Projects</span>
                </div>
            </div>
        </div>

        <!-- WS 4: Pure Terminal -->
        <div id="ws-content-4" class="ws-pane hidden bg-[#090d16]/98 rounded-xl border border-white/10 p-4 font-mono text-xs text-slate-200 relative z-10 min-h-[220px] flex flex-col justify-between">
            <div class="flex items-center justify-between pb-2 border-b border-white/5 text-[10px] text-slate-500">
                <span class="text-[#00b0f0]">veloxos@arch-niri:~ (tty)</span>
                <span>kitty</span>
            </div>
            <div class="space-y-1.5 text-slate-300 py-2">
                <p><span class="text-[#00b0f0]">veloxos@arch-niri</span> <span class="text-white">~</span> $ sudo pacman -Syu</p>
                <p class="text-slate-500">:: Synchronizing package databases...</p>
                <p class="text-slate-500"> core is up to date</p>
                <p class="text-slate-500"> extra is up to date</p>
                <p class="text-[#00b0f0]"> veloxos is up to date</p>
                <p class="text-emerald-400">:: Starting full system upgrade...</p>
                <p class="text-slate-400"> there is nothing to do</p>
            </div>
            <div class="pt-2 text-[11px] flex items-center gap-2 text-slate-400">
                <span class="text-[#00b0f0]">❯</span>
                <span class="w-1.5 h-3 bg-[#00b0f0] animate-pulse"></span>
            </div>
        </div>

    </div>
</div>

<script is:inline>
    const setupDesktopMockup = () => {
        const buttons = document.querySelectorAll('.ws-btn');
        const panes = document.querySelectorAll('.ws-pane');
        const titleEl = document.getElementById('activeAppTitle');

        const titles = {
            '1': 'kitty // fastfetch',
            '2': 'veloxos // emblem',
            '3': 'nautilus // file-manager',
            '4': 'kitty // terminal'
        };

        buttons.forEach(btn => {
            btn.onclick = () => {
                const ws = btn.getAttribute('data-ws');

                // Update Button Styles
                buttons.forEach(b => {
                    b.classList.remove('bg-[#00b0f0]', 'text-slate-950', 'font-bold');
                    b.classList.add('bg-white/5', 'text-slate-400');
                });
                btn.classList.remove('bg-white/5', 'text-slate-400');
                btn.classList.add('bg-[#00b0f0]', 'text-slate-950', 'font-bold');

                // Toggle Active Workspace Pane
                panes.forEach(p => p.classList.add('hidden'));
                const activePane = document.getElementById(`ws-content-${ws}`);
                if (activePane) activePane.classList.remove('hidden');

                // Update Topbar Title
                if (titleEl && ws && titles[ws]) {
                    titleEl.textContent = titles[ws];
                }
            };
        });
    };

    setupDesktopMockup();
    document.addEventListener('astro:after-swap', setupDesktopMockup);
</script>
