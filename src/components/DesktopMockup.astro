---
/* DesktopMockup.astro - Niri / Noctalia Concept Preview */
---

<div class="relative w-full rounded-xl border border-white/10 bg-[#070a12] shadow-2xl overflow-hidden font-sans group">
    
    <!-- NOCTALIA TOP BAR CONCEPT -->
    <div class="w-full h-8 bg-[#04060c]/90 border-b border-white/10 px-3 flex items-center justify-between font-mono text-[11px] text-slate-300 select-none">
        <!-- Workspaces (Niri Style) -->
        <div class="flex items-center gap-1.5">
            <span class="px-2 py-0.5 rounded bg-[#00b0f0] text-slate-950 font-bold text-[10px]">1</span>
            <span class="px-2 py-0.5 rounded bg-white/5 text-slate-400 hover:text-white transition-colors">2</span>
            <span class="px-2 py-0.5 rounded bg-white/5 text-slate-400 hover:text-white transition-colors">3</span>
            <span class="px-2 py-0.5 rounded bg-white/5 text-slate-400 hover:text-white transition-colors">4</span>
        </div>

        <!-- Center Brand / Active Window -->
        <div class="flex items-center gap-2">
            <img src="/new_favicon.png" alt="VeloxOS" class="h-3.5 w-auto" />
            <span class="text-slate-200 font-semibold tracking-wider text-[10px]">kitty // fastfetch</span>
        </div>

        <!-- System Tray & Status -->
        <div class="flex items-center gap-3 text-slate-400">
            <div class="flex items-center gap-1.5 text-[#00b0f0]">
                <span class="w-1.5 h-1.5 rounded-full bg-[#00b0f0] animate-pulse"></span>
                <span>NIRI</span>
            </div>
            <span>US</span>
            <span class="text-slate-200 font-medium">14:32</span>
        </div>
    </div>

    <!-- TILING WINDOW MANAGER WORKSPACE (Niri Layout) -->
    <div class="p-3 grid grid-cols-1 md:grid-cols-12 gap-3 min-h-[360px] bg-[#070a12] relative overflow-hidden">
        
        <!-- Ambient Background Glow inside Desktop -->
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(0,176,240,0.06),transparent_70%)] pointer-events-none"></div>

        <!-- WINDOW 1: KITTY TERMINAL WITH FASTFETCH (7 Cols) -->
        <div class="md:col-span-7 bg-[#090d16]/95 rounded-lg border border-[#00b0f0]/30 shadow-lg p-4 font-mono text-xs text-slate-200 flex flex-col justify-between relative overflow-hidden">
            <!-- Window Header -->
            <div class="flex items-center justify-between pb-3 mb-3 border-b border-white/5 text-[10px] text-slate-500">
                <span class="text-[#00b0f0]">veloxos@arch-niri:~</span>
                <span>kitty</span>
            </div>

            <!-- Terminal Content / Fastfetch -->
            <div class="space-y-3 relative z-10">
                <div class="flex items-start gap-4">
                    <!-- Logo ASCII / Emblem -->
                    <div class="text-[#00b0f0] font-black leading-none text-2xl pt-1 select-none">
                        <img src="/new_favicon.png" alt="VeloxOS" class="h-10 w-auto drop-shadow-[0_0_8px_rgba(0,176,240,0.5)]" />
                    </div>

                    <!-- Specs List -->
                    <div class="space-y-1 text-[11px] leading-relaxed">
                        <p><span class="text-[#00b0f0] font-bold">veloxos</span><span class="text-slate-500">@</span><span class="text-white font-bold">vanilla-arch</span></p>
                        <p class="text-slate-600">----------------------</p>
                        <p><span class="text-[#00b0f0]">OS:</span> VeloxOS (Vanilla Arch Base)</p>
                        <p><span class="text-[#00b0f0]">Kernel:</span> Linux 6.14.x-veloxos</p>
                        <p><span class="text-[#00b0f0]">WM:</span> Niri (Scrollable Wayland)</p>
                        <p><span class="text-[#00b0f0]">Shell:</span> Noctalia Shell / Fish</p>
                        <p><span class="text-[#00b0f0]">Terminal:</span> Kitty</p>
                        <p><span class="text-[#00b0f0]">Packages:</span> pacman (minimal)</p>
                    </div>
                </div>

                <!-- Palette Colors -->
                <div class="flex gap-1.5 pt-2">
                    <span class="w-3 h-3 rounded-xs bg-[#05080f] border border-white/10"></span>
                    <span class="w-3 h-3 rounded-xs bg-[#00b0f0]"></span>
                    <span class="w-3 h-3 rounded-xs bg-blue-600"></span>
                    <span class="w-3 h-3 rounded-xs bg-slate-700"></span>
                    <span class="w-3 h-3 rounded-xs bg-slate-300"></span>
                    <span class="w-3 h-3 rounded-xs bg-white"></span>
                </div>
            </div>

            <!-- Terminal Prompt -->
            <div class="pt-3 text-[11px] flex items-center gap-2 text-slate-400">
                <span class="text-[#00b0f0]">❯</span>
                <span class="text-slate-200">veloxos-pkg --check-updates</span>
                <span class="w-1.5 h-3 bg-[#00b0f0] animate-pulse"></span>
            </div>
        </div>

        <!-- WINDOW 2: SECOND TILING WINDOW / SYSTEM GRAPH (5 Cols) -->
        <div class="md:col-span-5 bg-[#090d16]/70 rounded-lg border border-white/10 p-4 font-mono text-xs flex flex-col justify-between relative overflow-hidden">
            <!-- Window Header -->
            <div class="flex items-center justify-between pb-3 mb-3 border-b border-white/5 text-[10px] text-slate-500">
                <span>performance // monitor</span>
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            </div>

            <!-- System Metrics -->
            <div class="space-y-4">
                <div>
                    <div class="flex justify-between text-[11px] mb-1">
                        <span class="text-slate-400">CPU Usage</span>
                        <span class="text-[#00b0f0] font-bold">2.1 %</span>
                    </div>
                    <div class="w-full bg-white/5 h-1.5 rounded-full overflow-hidden">
                        <div class="bg-[#00b0f0] h-full w-[12%] rounded-full"></div>
                    </div>
                </div>

                <div>
                    <div class="flex justify-between text-[11px] mb-1">
                        <span class="text-slate-400">RAM (Low-Latency)</span>
                        <span class="text-[#00b0f0] font-bold">1.2 / 32 GB</span>
                    </div>
                    <div class="w-full bg-white/5 h-1.5 rounded-full overflow-hidden">
                        <div class="bg-blue-500 h-full w-[18%] rounded-full"></div>
                    </div>
                </div>

                <div class="p-2.5 rounded bg-black/40 border border-white/5 text-[10px] text-slate-400 leading-relaxed">
                    <span class="text-[#00b0f0] font-bold">NIRI SCROLLING:</span> Active workspace seamlessly spans infinite horizonal columns.
                </div>
            </div>

            <!-- Footer Badge -->
            <div class="pt-2 text-right">
                <span class="text-[9px] text-slate-500 font-bold uppercase tracking-widest bg-white/5 px-2 py-1 rounded">Wayland Native</span>
            </div>
        </div>

    </div>
</div>
