---
import Layout from '../layouts/MainLayout.astro';
---

<Layout title="VeloxOS - About the Project">
    <div id="page-content" class="pt-8 pb-20">
        
        <section class="max-w-5xl mx-auto px-6 relative z-10">
            
            <!-- HEADER -->
            <div class="text-center mb-16">
                <span class="font-mono text-xs font-bold uppercase tracking-widest text-[#00b0f0] bg-[#00b0f0]/10 px-3.5 py-1.5 rounded-full border border-[#00b0f0]/20 mb-4 inline-block">
                    // PROJECT BACKGROUND
                </span>
                <h1 class="text-4xl md:text-6xl font-extrabold text-white mb-6 tracking-tight">
                    About <span class="text-[#00b0f0]">VeloxOS</span>
                </h1>
                <p class="text-slate-300 text-lg max-w-2xl mx-auto leading-relaxed font-normal">
                    More than just another distribution — a personal quest for the perfect balance between speed, stability, and modern aesthetics.
                </p>
            </div>

            <!-- ORIGIN STORY & MISSION GRID -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
                
                <!-- 01. Origin Story -->
                <div class="group relative p-8 bg-[#090d16] rounded-xl border border-white/10 transition-all duration-300 hover:border-[#00b0f0]/40">
                    <div class="absolute top-0 left-0 w-1 h-full bg-[#00b0f0] rounded-l-xl"></div>
                    <div class="font-mono text-xs font-bold text-[#00b0f0] mb-3">01. ORIGIN</div>
                    <h3 class="text-white text-xl font-bold mb-3 flex items-center gap-2">
                        📜 The Origin Story
                    </h3>
                    <p class="text-slate-400 leading-relaxed text-[15px]">
                        The project began with a practical need: a "pre-baked" image of my perfectly tuned system. What started as a personal utility evolved into a deep exploration of Linux architecture — ultimately becoming my most ambitious learning journey.
                    </p>
                </div>

                <!-- 02. Mission -->
                <div class="group relative p-8 bg-[#090d16] rounded-xl border border-white/10 transition-all duration-300 hover:border-[#00b0f0]/40">
                    <div class="absolute top-0 left-0 w-1 h-full bg-[#00b0f0] rounded-l-xl"></div>
                    <div class="font-mono text-xs font-bold text-[#00b0f0] mb-3">02. MISSION</div>
                    <h3 class="text-white text-xl font-bold mb-3 flex items-center gap-2">
                        🎯 Our Mission
                    </h3>
                    <p class="text-slate-400 leading-relaxed text-[15px]">
                        To provide a seamless experience where power users and newcomers alike can enjoy the full potential of their hardware—without the setup hassle. Performance — accessible to everyone.
                    </p>
                </div>

            </div>

            <!-- THE VISION CARD -->
            <div class="relative group mb-20">
                <div class="relative bg-[#090d16] p-8 md:p-12 rounded-xl border border-white/10 transition-all duration-300 overflow-hidden">
                    <div class="flex flex-col md:flex-row gap-8 items-start">
                        <div class="flex-1">
                            <h3 class="text-[#00b0f0] text-2xl font-bold mb-4 flex items-center gap-3">
                                💡 The Vision: Human & AI Synergy
                            </h3>
                            <p class="text-slate-300 mb-8 leading-relaxed text-lg font-normal">
                                VeloxOS explores modern development workflows by integrating AI to assist in optimization, troubleshooting, and documentation. We explore how intelligent tools can empower a single developer to deliver world-class results — without ever compromising stability.
                            </p>
                            
                            <div class="p-5 bg-black/40 rounded-lg border border-white/10 text-sm leading-relaxed text-slate-300 font-mono">
                                <div class="flex items-start gap-3">
                                    <svg class="w-5 h-5 text-[#00b0f0] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                                    <p>
                                        <strong class="text-[#00b0f0] uppercase tracking-wider">Security & Privacy Note:</strong><br/>
                                        No AI software, LLMs, or telemetry services are integrated into the distribution itself. VeloxOS remains a pure, high-performance Linux environment.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- MEET THE MIND -->
            <div class="mt-20">
                <div class="flex items-center gap-4 mb-8">
                    <div class="h-1 w-10 bg-[#00b0f0] rounded-full"></div>
                    <h2 class="text-white text-3xl font-extrabold tracking-tight">Meet the Mind</h2>
                </div>

                <div class="relative group">
                    <div class="relative bg-[#090d16] p-8 md:p-10 rounded-xl border border-white/10 flex flex-wrap md:flex-nowrap items-center gap-10">
                        <div class="relative mx-auto md:mx-0 flex-shrink-0">
                            <div class="absolute -inset-1 bg-[#00b0f0]/20 rounded-full blur-md"></div>
                            <img 
                                src="/skully.png" 
                                alt="WurzelRitter" 
                                class="relative w-32 h-32 md:w-36 md:h-36 rounded-full border-2 border-white/20 shadow-2xl object-cover"
                            />
                        </div>

                        <div class="flex-1 text-center md:text-left">
                            <h3 class="text-white text-2xl font-bold mb-2">Timo <span class="text-[#00b0f0] opacity-90">(WurzelRitter)</span></h3>
                            <p class="font-mono text-xs font-bold uppercase tracking-wider text-[#00b0f0] bg-[#00b0f0]/10 inline-block px-3 py-1.5 rounded-md border border-[#00b0f0]/20 mb-5">Founder & Lead Developer</p>
                            
                            <p class="text-slate-400 mb-8 leading-relaxed text-sm">
                                Driven by a passion for efficiency and clean design. Building VeloxOS as proof that one person, equipped with the right tools, can create a high-performance ecosystem.
                            </p>

                            <div class="flex justify-center md:justify-start gap-4 font-mono text-xs">
                                <a href="https://x.com/HrSkully" target="_blank" class="flex items-center justify-center px-6 py-3 bg-[#00b0f0] hover:bg-[#0096ce] text-slate-950 rounded-lg font-bold transition-all shadow-md shadow-[#00b0f0]/20">
                                    X (Twitter)
                                </a>
                                <a href="https://github.com/WurzelRitter" target="_blank" class="flex items-center justify-center px-6 py-3 bg-white/[0.03] hover:bg-white/[0.08] text-white border border-white/10 rounded-lg font-bold transition-all">
                                    GitHub
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </section>
    </div>
</Layout>
