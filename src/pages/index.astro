---
import Layout from '../layouts/MainLayout.astro';
---

<Layout title="VeloxOS - Minimal. Fast. Yours.">

    <div id="page-content">

        <!-- =========================================================
             PROJECT REBOOT BANNER
             ========================================================= -->

        <div
            class="w-full
                   bg-gradient-to-r
                   from-amber-500/10
                   via-[#00b0f0]/10
                   to-amber-500/10
                   border-b
                   border-amber-500/20
                   py-4
                   px-6
                   transition-colors
                   duration-300"
        >

            <div
                class="max-w-6xl
                       mx-auto
                       flex
                       flex-col
                       sm:flex-row
                       items-center
                       justify-between
                       gap-4
                       text-center
                       sm:text-left"
            >

                <div
                    class="flex
                           items-center
                           gap-3
                           flex-col
                           sm:flex-row"
                >

                    <span
                        class="px-2.5
                               py-1
                               text-xs
                               font-bold
                               uppercase
                               tracking-wider
                               text-amber-600
                               dark:text-amber-400
                               bg-amber-500/10
                               rounded
                               border
                               border-amber-500/20
                               animate-pulse"
                    >
                        Project Reboot
                    </span>

                    <p
                        class="text-sm
                               text-slate-700
                               dark:text-slate-300
                               font-medium"
                    >
                        <strong class="text-slate-900 dark:text-white">
                            VeloxOS is stepping up a gear!
                        </strong>
                        We are completely restructuring the distribution.
                    </p>

                </div>

            </div>

        </div>


        <!-- =========================================================
             HERO
             ========================================================= -->

        <section
            class="relative
                   pt-24
                   md:pt-32
                   pb-24
                   md:pb-32
                   overflow-hidden
                   transition-colors
                   duration-300"
        >

            <!-- =====================================================
                 BACKGROUND GLOW
                 ===================================================== -->

            <div
                class="absolute
                       inset-0
                       overflow-hidden
                       pointer-events-none"
            >

                <!-- Main logo glow -->

                <div
                    class="absolute
                           left-1/2
                           -translate-x-1/2
                           -top-20
                           w-[500px]
                           md:w-[800px]
                           h-[420px]
                           md:h-[600px]
                           bg-[#00b0f0]/10
                           blur-[120px]
                           md:blur-[160px]
                           rounded-full"
                ></div>


                <!-- Lower subtle glow -->

                <div
                    class="absolute
                           left-1/2
                           -translate-x-1/2
                           top-[520px]
                           w-[600px]
                           md:w-[1000px]
                           h-[350px]
                           bg-blue-700/5
                           blur-[120px]
                           rounded-full"
                ></div>


                <!-- Decorative horizontal line -->

                <div
                    class="absolute
                           left-1/2
                           top-[360px]
                           -translate-x-1/2
                           w-[900px]
                           max-w-[90vw]
                           h-px
                           bg-gradient-to-r
                           from-transparent
                           via-[#00b0f0]/10
                           to-transparent"
                ></div>

            </div>


            <!-- =====================================================
                 HERO CONTENT
                 ===================================================== -->

            <div
                class="relative
                       max-w-6xl
                       mx-auto
                       px-6"
            >

                <div class="text-center">


                    <!-- =================================================
                         VELOXOS LOGO
                         ================================================= -->

                    <div
                        class="flex
                               justify-center
                               mb-12
                               md:mb-14"
                    >

                        <div
                            class="relative
                                   drop-shadow-[0_0_45px_rgba(0,176,240,0.25)]"
                        >

                            <!-- Logo glow -->

                            <div
                                class="absolute
                                       inset-0
                                       bg-[#00b0f0]/10
                                       blur-3xl
                                       rounded-full
                                       scale-150
                                       pointer-events-none"
                            ></div>


                            <!-- Actual VeloxOS logo -->

                            <img
                                src="https://wiki.veloxos.org/_astro/new_logo.CxzxC9pm_2vCcGx.webp"
                                alt="VeloxOS"
                                class="relative
                                       w-auto
                                       h-32
                                       md:h-48
                                       lg:h-56
                                       object-contain"
                            />

                        </div>

                    </div>


                    <!-- =================================================
                         SUBTITLE
                         ================================================= -->

                    <p
                        class="text-2xl
                               md:text-3xl
                               lg:text-4xl
                               font-semibold
                               tracking-tight
                               leading-tight
                               mb-7
                               text-slate-900
                               dark:text-white"
                    >

                        <span class="text-[#00b0f0]">
                            Minimal.
                        </span>

                        Fast. Yours.

                    </p>


                    <!-- =================================================
                         DESCRIPTION
                         ================================================= -->

                    <p
                        class="mx-auto
                               max-w-2xl
                               text-base
                               md:text-lg
                               text-slate-600
                               dark:text-slate-400
                               leading-relaxed
                               mb-10"
                    >

                        <span
                            class="text-slate-900
                                   dark:text-white
                                   font-semibold"
                        >
                            VeloxOS
                        </span>

                        is a performance-driven Linux distribution built
                        on reproducible system properties. Designed for
                        gamers and power users, it delivers a modern
                        software stack and extreme system responsiveness
                        — without compromising on stability or control.

                    </p>


                    <!-- =================================================
                         BUTTONS
                         ================================================= -->

                    <div
                        class="flex
                               flex-col
                               sm:flex-row
                               items-center
                               justify-center
                               gap-4"
                    >

                        <!-- Download -->

                        <button
                            onclick="openVeloxModal()"
                            class="w-full
                                   sm:w-auto
                                   px-8
                                   py-4
                                   bg-[#00b0f0]
                                   hover:bg-[#00d4ff]
                                   text-white
                                   font-bold
                                   rounded-xl
                                   transition-all
                                   transform
                                   hover:-translate-y-1
                                   shadow-[0_4px_25px_rgba(0,176,240,0.30)]
                                   hover:shadow-[0_8px_35px_rgba(0,176,240,0.40)]
                                   flex
                                   items-center
                                   justify-center
                                   gap-2
                                   cursor-pointer"
                        >

                            <svg
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >

                                <path
                                    d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
                                ></path>

                                <polyline
                                    points="7 10 12 15 17 10"
                                ></polyline>

                                <line
                                    x1="12"
                                    y1="15"
                                    x2="12"
                                    y2="3"
                                ></line>

                            </svg>

                            Try VeloxOS (ISO)

                        </button>


                        <!-- Learn More -->

                        <a
                            href="#why-veloxos"
                            class="w-full
                                   sm:w-auto
                                   px-8
                                   py-4
                                   bg-slate-100
                                   dark:bg-white/5
                                   hover:bg-slate-200
                                   dark:hover:bg-white/10
                                   text-slate-900
                                   dark:text-white
                                   font-semibold
                                   rounded-xl
                                   border
                                   border-slate-200
                                   dark:border-white/20
                                   transition-all
                                   hover:border-[#00b0f0]
                                   flex
                                   items-center
                                   justify-center"
                        >
                            Learn More
                        </a>

                    </div>

                </div>

            </div>

        </section>


        <!-- =========================================================
             WHY VELOXOS
             ========================================================= -->

        <section
            id="why-veloxos"
            class="max-w-6xl
                   mx-auto
                   px-6
                   py-24
                   md:py-32"
        >

            <div
                class="text-center
                       mb-16"
            >

                <div
                    class="inline-flex
                           items-center
                           gap-2
                           px-3
                           py-1.5
                           rounded-full
                           border
                           border-[#00b0f0]/20
                           bg-[#00b0f0]/5
                           text-[#00b0f0]
                           text-xs
                           font-semibold
                           uppercase
                           tracking-widest
                           mb-6"
                >
                    Why VeloxOS
                </div>


                <h2
                    class="text-3xl
                           md:text-5xl
                           font-extrabold
                           mb-4
                           text-slate-900
                           dark:text-white
                           tracking-tight"
                >
                    Built with purpose.
                </h2>


                <p
                    class="text-slate-600
                           dark:text-slate-400
                           text-lg
                           max-w-2xl
                           mx-auto"
                >
                    The perfect balance between extreme performance
                    and reliability.
                </p>

            </div>


            <!-- =====================================================
                 FEATURE GRID
                 ===================================================== -->

            <div
                class="grid
                       md:grid-cols-3
                       gap-6"
            >


                <!-- =================================================
                     FEATURE 1
                     ================================================= -->

                <div
                    class="group
                           relative
                           bg-slate-50
                           dark:bg-white/[0.02]
                           border
                           border-slate-200
                           dark:border-white/10
                           p-8
                           rounded-[24px]
                           transition-all
                           duration-500
                           hover:-translate-y-2
                           hover:border-[#00b0f0]/50
                           shadow-sm
                           hover:shadow-2xl
                           hover:shadow-[#00b0f0]/10"
                >

                    <div
                        class="w-12
                               h-12
                               bg-[#00b0f0]/10
                               rounded-xl
                               flex
                               items-center
                               justify-center
                               mb-6
                               group-hover:scale-110
                               transition-transform
                               duration-500"
                    >

                        <svg
                            class="w-6
                                   h-6
                                   text-[#00b0f0]"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >

                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M13 10V3L4 14h7v7l9-11h-7z"
                            ></path>

                        </svg>

                    </div>


                    <h3
                        class="text-xl
                               font-bold
                               mb-4
                               text-slate-900
                               dark:text-white"
                    >
                        Tuned for Speed
                    </h3>


                    <p
                        class="text-slate-600
                               dark:text-slate-400
                               leading-relaxed
                               text-[15px]"
                    >
                        Powered by custom kernel tweaks, we minimize
                        latency and squeeze the maximum performance
                        out of your gaming hardware.
                    </p>

                </div>


                <!-- =================================================
                     FEATURE 2
                     ================================================= -->

                <div
                    class="group
                           relative
                           bg-slate-50
                           dark:bg-white/[0.02]
                           border
                           border-slate-200
                           dark:border-white/10
                           p-8
                           rounded-[24px]
                           transition-all
                           duration-500
                           hover:-translate-y-2
                           hover:border-[#00b0f0]/50
                           shadow-sm
                           hover:shadow-2xl
                           hover:shadow-[#00b0f0]/10"
                >

                    <div
                        class="w-12
                               h-12
                               bg-[#00b0f0]/10
                               rounded-xl
                               flex
                               items-center
                               justify-center
                               mb-6
                               group-hover:scale-110
                               transition-transform
                               duration-500"
                    >

                        <svg
                            class="w-6
                                   h-6
                                   text-[#00b0f0]"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >

                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z"
                            ></path>

                        </svg>

                    </div>


                    <h3
                        class="text-xl
                               font-bold
                               mb-4
                               text-slate-900
                               dark:text-white"
                    >
                        Zero Configuration Required
                    </h3>


                    <p
                        class="text-slate-600
                               dark:text-slate-400
                               leading-relaxed
                               text-[15px]"
                    >
                        Save yourself hours of manual setup. Essential
                        tools like
                        <span
                            class="text-[#00b0f0]
                                   font-medium"
                        >
                            Steam, ProtonUp-Qt, and ZRAM optimizations
                        </span>
                        are baked right into the system.
                    </p>

                </div>


                <!-- =================================================
                     FEATURE 3
                     ================================================= -->

                <div
                    class="group
                           relative
                           bg-slate-50
                           dark:bg-white/[0.02]
                           border
                           border-slate-200
                           dark:border-white/10
                           p-8
                           rounded-[24px]
                           transition-all
                           duration-500
                           hover:-translate-y-2
                           hover:border-[#00b0f0]/50
                           shadow-sm
                           hover:shadow-2xl
                           hover:shadow-[#00b0f0]/10"
                >

                    <div
                        class="w-12
                               h-12
                               bg-[#00b0f0]/10
                               rounded-xl
                               flex
                               items-center
                               justify-center
                               mb-6
                               group-hover:scale-110
                               transition-transform
                               duration-500"
                    >

                        <svg
                            class="w-6
                                   h-6
                                   text-[#00b0f0]"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >

                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 00-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                            ></path>

                        </svg>

                    </div>


                    <h3
                        class="text-xl
                               font-bold
                               mb-4
                               text-slate-900
                               dark:text-white"
                    >
                        100% Secure via Snapshots
                    </h3>


                    <p
                        class="text-slate-600
                               dark:text-slate-400
                               leading-relaxed
                               text-[15px]"
                    >
                        No more broken updates. Your entire OS is backed
                        up via snapshots. If something fails, instantly
                        rollback to a working previous state. Clean and
                        unbreakable.
                    </p>

                </div>

            </div>

        </section>


        <!-- =========================================================
             DOWNLOAD MODAL
             ========================================================= -->

        <div
            id="veloxDownloadModal"
            class="hidden
                   fixed
                   inset-0
                   z-[9999]
                   bg-black/80
                   backdrop-blur-md
                   items-center
                   justify-center
                   p-4"
        >

            <div
                class="bg-white
                       dark:bg-[#0d1117]
                       border
                       border-[#00b0f0]/30
                       p-8
                       rounded-[28px]
                       max-w-lg
                       w-full
                       text-center
                       shadow-2xl
                       relative
                       overflow-hidden"
            >

                <!-- Modal glow -->

                <div
                    class="absolute
                           -top-32
                           left-1/2
                           -translate-x-1/2
                           w-64
                           h-64
                           bg-[#00b0f0]/10
                           blur-[80px]
                           rounded-full
                           pointer-events-none"
                ></div>


                <!-- Icon -->

                <div
                    class="relative
                           w-20
                           h-20
                           bg-[#00b0f0]/10
                           rounded-2xl
                           flex
                           items-center
                           justify-center
                           mx-auto
                           mb-6"
                >

                    <svg
                        width="40"
                        height="40"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="#00b0f0"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >

                        <circle
                            cx="12"
                            cy="12"
                            r="10"
                        ></circle>

                        <polyline
                            points="12 6 12 12 16 14"
                        ></polyline>

                    </svg>

                </div>


                <h2
                    class="text-3xl
                           font-bold
                           text-slate-900
                           dark:text-white
                           mb-4"
                >
                    Under Restructuring
                </h2>


                <div
                    class="space-y-4
                           text-slate-600
                           dark:text-slate-400
                           mb-8"
                >

                    <p class="text-lg">
                        The upcoming generation of VeloxOS is being
                        rebuilt from the ground up.
                    </p>


                    <p
                        class="bg-[#00b0f0]/5
                               py-3
                               px-4
                               rounded-xl
                               border
                               border-[#00b0f0]/10
                               text-[#00b0f0]
                               font-semibold"
                    >
                        Concept phase for the new architecture active
                    </p>

                </div>


                <div class="flex flex-col gap-3">

                    <button
                        onclick="closeVeloxModal()"
                        class="w-full
                               py-3
                               text-slate-500
                               hover:text-slate-700
                               dark:hover:text-white
                               transition-colors
                               text-sm
                               font-medium
                               uppercase
                               tracking-widest"
                    >
                        Close
                    </button>

                </div>

            </div>

        </div>


        <!-- =========================================================
             MODAL SCRIPT
             ========================================================= -->

        <script is:inline>

            function openVeloxModal() {

                const modal =
                    document.getElementById("veloxDownloadModal");

                if (!modal) return;

                modal.classList.remove("hidden");

                modal.style.display = "flex";

                document.body.style.overflow = "hidden";
            }


            function closeVeloxModal() {

                const modal =
                    document.getElementById("veloxDownloadModal");

                if (!modal) return;

                modal.classList.add("hidden");

                modal.style.display = "none";

                document.body.style.overflow = "auto";
            }


            window.addEventListener("click", function(event) {

                const modal =
                    document.getElementById("veloxDownloadModal");

                if (
                    modal &&
                    event.target === modal
                ) {

                    closeVeloxModal();

                }

            });


            window.addEventListener("keydown", function(event) {

                if (event.key === "Escape") {

                    closeVeloxModal();

                }

            });

        </script>

    </div>

</Layout>
