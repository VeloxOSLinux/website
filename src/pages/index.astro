---
import Layout from '../layouts/MainLayout.astro';
---

<Layout title="VeloxOS - Minimal. Fast. Yours.">

    <div id="page-content">

        <!-- =========================================================
             PROJECT REBOOT
             ========================================================= -->

        <div
            class="w-full
                   border-b
                   border-slate-200
                   bg-white
                   dark:border-white/[0.06]
                   dark:bg-[#080d16]
                   transition-colors
                   duration-300"
        >

            <div
                class="mx-auto
                       flex
                       max-w-6xl
                       flex-col
                       items-center
                       justify-center
                       gap-2
                       px-6
                       py-3
                       text-center
                       sm:flex-row"
            >

                <span
                    class="rounded
                           border
                           border-amber-400/30
                           bg-amber-400/[0.08]
                           px-2.5
                           py-1
                           text-[10px]
                           font-bold
                           uppercase
                           tracking-[0.15em]
                           text-amber-600
                           dark:text-amber-400"
                >
                    Project Reboot
                </span>


                <p
                    class="text-xs
                           text-slate-500
                           dark:text-slate-400
                           sm:text-sm"
                >

                    <strong
                        class="font-semibold
                               text-slate-800
                               dark:text-slate-200"
                    >
                        VeloxOS is stepping up a gear!
                    </strong>

                    <span class="ml-1">
                        We are completely restructuring the distribution.
                    </span>

                </p>

            </div>

        </div>


        <!-- =========================================================
             HERO
             ========================================================= -->

        <section
            class="relative
                   isolate
                   overflow-hidden
                   border-b
                   border-slate-200
                   bg-slate-50
                   px-6
                   pb-28
                   pt-24
                   transition-colors
                   duration-300
                   dark:border-white/[0.06]
                   dark:bg-[#070c16]
                   md:pb-36
                   md:pt-32"
        >

            <!-- Very subtle atmosphere -->

            <div
                class="pointer-events-none
                       absolute
                       inset-x-0
                       top-0
                       -z-10
                       h-[420px]
                       bg-[radial-gradient(ellipse_55%_45%_at_50%_0%,rgba(0,176,240,0.055),transparent_72%)]
                       dark:bg-[radial-gradient(ellipse_55%_45%_at_50%_0%,rgba(0,176,240,0.075),transparent_72%)]"
            ></div>


            <!-- Subtle technical grid -->

            <div
                class="pointer-events-none
                       absolute
                       inset-0
                       -z-10
                       opacity-[0.025]
                       dark:opacity-[0.035]"
                style="
                    background-image:
                        linear-gradient(to right, currentColor 1px, transparent 1px),
                        linear-gradient(to bottom, currentColor 1px, transparent 1px);
                    background-size: 72px 72px;
                "
            ></div>


            <!-- =====================================================
                 HERO CONTENT
                 ===================================================== -->

            <div
                class="relative
                       mx-auto
                       max-w-5xl
                       text-center"
            >

                <!-- =================================================
                     LOGO
                     ================================================= -->

                <div
                    class="mb-12
                           flex
                           justify-center
                           md:mb-14"
                >

                    <img
                        src="https://wiki.veloxos.org/_astro/new_logo.CxzxC9pm_2vCcGx.webp"
                        alt="VeloxOS"
                        class="h-40
                               w-auto
                               object-contain
                               drop-shadow-[0_0_30px_rgba(0,176,240,0.12)]
                               transition-all
                               duration-300
                               dark:drop-shadow-[0_0_40px_rgba(0,176,240,0.16)]
                               sm:h-44
                               md:h-52
                               lg:h-56"
                    />

                </div>


                <!-- =================================================
                     TAGLINE
                     ================================================= -->

                <h1
                    class="mb-6
                           text-xl
                           font-semibold
                           leading-tight
                           tracking-tight
                           text-slate-700
                           dark:text-slate-200
                           sm:text-2xl"
                >

                    <span class="text-[#00b0f0]">
                        Minimal.
                    </span>

                    Fast. Yours.

                </h1>


                <!-- =================================================
                     DESCRIPTION
                     ================================================= -->

                <p
                    class="mx-auto
                           mb-9
                           max-w-2xl
                           text-base
                           leading-7
                           text-slate-500
                           dark:text-slate-400
                           md:text-lg
                           md:leading-8"
                >

                    <span
                        class="font-semibold
                               text-slate-800
                               dark:text-slate-200"
                    >
                        VeloxOS
                    </span>

                    is a performance-driven Linux distribution built
                    on reproducible system properties. Designed for
                    gamers and power users, it delivers a modern
                    software stack and extreme system responsiveness
                    — without compromising on stability or control.

                </p>


                <!-- =================================================
                     ACTIONS
                     ================================================= -->

                <div
                    class="flex
                           flex-col
                           items-center
                           justify-center
                           gap-3
                           sm:flex-row"
                >

                    <!-- Primary -->

                    <button
                        onclick="openVeloxModal()"
                        class="flex
                               w-full
                               items-center
                               justify-center
                               gap-2
                               rounded-xl
                               bg-[#00b0f0]
                               px-7
                               py-3.5
                               text-sm
                               font-bold
                               text-white
                               shadow-[0_8px_30px_rgba(0,176,240,0.18)]
                               transition-all
                               duration-300
                               hover:-translate-y-0.5
                               hover:bg-[#00c8ff]
                               hover:shadow-[0_10px_35px_rgba(0,176,240,0.28)]
                               sm:w-auto"
                    >

                        <svg
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >

                            <path
                                d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
                            ></path>

                            <polyline
                                points="7 10 12 15 17 10"
                            ></polyline>

                            <line
                                x1="12"
                                y1="15"
                                x2="12"
                                y2="3"
                            ></line>

                        </svg>

                        Try VeloxOS (ISO)

                    </button>


                    <!-- Secondary -->

                    <a
                        href="#why-veloxos"
                        class="flex
                               w-full
                               items-center
                               justify-center
                               rounded-xl
                               border
                               border-slate-200
                               bg-white
                               px-7
                               py-3.5
                               text-sm
                               font-semibold
                               text-slate-700
                               transition-all
                               duration-300
                               hover:-translate-y-0.5
                               hover:border-[#00b0f0]/40
                               hover:bg-slate-50
                               dark:border-white/[0.10]
                               dark:bg-white/[0.025]
                               dark:text-slate-200
                               dark:hover:border-[#00b0f0]/40
                               dark:hover:bg-white/[0.05]
                               sm:w-auto"
                    >
                        Learn More
                    </a>

                </div>

            </div>


            <!-- Bottom separator -->

            <div
                class="pointer-events-none
                       absolute
                       inset-x-0
                       bottom-0
                       h-px
                       bg-gradient-to-r
                       from-transparent
                       via-slate-300
                       to-transparent
                       dark:via-white/[0.08]"
            ></div>

        </section>


        <!-- =========================================================
             WHY VELOXOS
             ========================================================= -->

        <section
            id="why-veloxos"
            class="relative
                   overflow-hidden
                   bg-white
                   px-6
                   py-24
                   transition-colors
                   duration-300
                   dark:bg-[#0a101b]
                   md:py-32"
        >

            <!-- Very subtle background -->

            <div
                class="pointer-events-none
                       absolute
                       inset-0
                       opacity-[0.018]
                       dark:opacity-[0.025]"
                style="
                    background-image:
                        linear-gradient(to right, currentColor 1px, transparent 1px),
                        linear-gradient(to bottom, currentColor 1px, transparent 1px);
                    background-size: 72px 72px;
                "
            ></div>


            <div
                class="relative
                       mx-auto
                       max-w-6xl"
            >

                <!-- =================================================
                     SECTION HEADER
                     ================================================= -->

                <div
                    class="mb-14
                           text-center
                           md:mb-16"
                >

                    <div
                        class="mb-5
                               inline-flex
                               items-center
                               rounded-full
                               border
                               border-[#00b0f0]/20
                               bg-[#00b0f0]/[0.04]
                               px-3
                               py-1.5
                               text-[10px]
                               font-bold
                               uppercase
                               tracking-[0.2em]
                               text-[#00b0f0]"
                    >
                        Why VeloxOS
                    </div>


                    <h2
                        class="mb-4
                               text-3xl
                               font-extrabold
                               tracking-tight
                               text-slate-900
                               dark:text-white
                               md:text-5xl"
                    >
                        Built with purpose.
                    </h2>


                    <p
                        class="mx-auto
                               max-w-2xl
                               text-base
                               leading-7
                               text-slate-500
                               dark:text-slate-400
                               md:text-lg"
                    >
                        A Linux desktop designed around performance,
                        gaming, reproducibility and control.
                    </p>

                </div>


                <!-- =================================================
                     TECHNICAL GRID
                     ================================================= -->

                <div
                    class="grid
                           gap-4
                           md:grid-cols-2"
                >


                    <!-- =================================================
                         PERFORMANCE
                         ================================================= -->

                    <article
                        class="group
                               relative
                               overflow-hidden
                               rounded-2xl
                               border
                               border-slate-200
                               bg-slate-50
                               p-7
                               transition-all
                               duration-300
                               hover:-translate-y-1
                               hover:border-[#00b0f0]/35
                               hover:bg-white
                               dark:border-white/[0.07]
                               dark:bg-white/[0.025]
                               dark:hover:border-[#00b0f0]/30
                               dark:hover:bg-white/[0.045]"
                    >

                        <div
                            class="absolute
                                   left-0
                                   top-0
                                   h-px
                                   w-0
                                   bg-[#00b0f0]
                                   transition-all
                                   duration-500
                                   group-hover:w-full"
                        ></div>


                        <div
                            class="mb-6
                                   flex
                                   items-start
                                   justify-between"
                        >

                            <div
                                class="flex
                                       h-11
                                       w-11
                                       items-center
                                       justify-center
                                       rounded-xl
                                       border
                                       border-[#00b0f0]/15
                                       bg-[#00b0f0]/[0.07]"
                            >

                                <svg
                                    class="h-5 w-5 text-[#00b0f0]"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >

                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M13 10V3L4 14h7v7l9-11h-7z"
                                    ></path>

                                </svg>

                            </div>


                            <span
                                class="font-mono
                                       text-[10px]
                                       font-bold
                                       tracking-[0.2em]
                                       text-slate-400
                                       dark:text-slate-600"
                            >
                                01
                            </span>

                        </div>


                        <h3
                            class="mb-3
                                   text-xl
                                   font-bold
                                   text-slate-900
                                   dark:text-white"
                        >
                            Performance
                        </h3>


                        <p
                            class="text-sm
                                   leading-6
                                   text-slate-500
                                   dark:text-slate-400"
                        >
                            A system tuned for responsiveness, low
                            latency and efficient resource usage.
                            VeloxOS puts the desktop experience first
                            instead of adding unnecessary layers.
                        </p>


                        <div
                            class="mt-6
                                   flex
                                   flex-wrap
                                   gap-2"
                        >

                            <span
                                class="rounded-md
                                       border
                                       border-slate-200
                                       bg-white
                                       px-2.5
                                       py-1
                                       font-mono
                                       text-[10px]
                                       text-slate-500
                                       dark:border-white/[0.06]
                                       dark:bg-white/[0.025]
                                       dark:text-slate-500"
                            >
                                LOW LATENCY
                            </span>

                            <span
                                class="rounded-md
                                       border
                                       border-slate-200
                                       bg-white
                                       px-2.5
                                       py-1
                                       font-mono
                                       text-[10px]
                                       text-slate-500
                                       dark:border-white/[0.06]
                                       dark:bg-white/[0.025]
                                       dark:text-slate-500"
                            >
                                RESPONSIVE
                            </span>

                        </div>

                    </article>


                    <!-- =================================================
                         GAMING
                         ================================================= -->

                    <article
                        class="group
                               relative
                               overflow-hidden
                               rounded-2xl
                               border
                               border-slate-200
                               bg-slate-50
                               p-7
                               transition-all
                               duration-300
                               hover:-translate-y-1
                               hover:border-[#00b0f0]/35
                               hover:bg-white
                               dark:border-white/[0.07]
                               dark:bg-white/[0.025]
                               dark:hover:border-[#00b0f0]/30
                               dark:hover:bg-white/[0.045]"
                    >

                        <div
                            class="absolute
                                   left-0
                                   top-0
                                   h-px
                                   w-0
                                   bg-[#00b0f0]
                                   transition-all
                                   duration-500
                                   group-hover:w-full"
                        ></div>


                        <div
                            class="mb-6
                                   flex
                                   items-start
                                   justify-between"
                        >

                            <div
                                class="flex
                                       h-11
                                       w-11
                                       items-center
                                       justify-center
                                       rounded-xl
                                       border
                                       border-[#00b0f0]/15
                                       bg-[#00b0f0]/[0.07]"
                            >

                                <svg
                                    class="h-5 w-5 text-[#00b0f0]"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >

                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M6.5 6.5h11a4.5 4.5 0 014.3 5.8l-1.1 3.8a3.5 3.5 0 01-6.5.7l-.7-1.2H10.5l-.7 1.2a3.5 3.5 0 01-6.5-.7l-1.1-3.8a4.5 4.5 0 014.3-5.8z"
                                    ></path>

                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M8 10v4M6 12h4M16 11h.01M19 13h.01"
                                    ></path>

                                </svg>

                            </div>


                            <span
                                class="font-mono
                                       text-[10px]
                                       font-bold
                                       tracking-[0.2em]
                                       text-slate-400
                                       dark:text-slate-600"
                            >
                                02
                            </span>

                        </div>


                        <h3
                            class="mb-3
                                   text-xl
                                   font-bold
                                   text-slate-900
                                   dark:text-white"
                        >
                            Gaming
                        </h3>


                        <p
                            class="text-sm
                                   leading-6
                                   text-slate-500
                                   dark:text-slate-400"
                        >
                            Built with modern Linux gaming in mind.
                            Steam, Proton and the surrounding tooling
                            are treated as first-class parts of the
                            desktop experience.
                        </p>


                        <div
                            class="mt-6
                                   flex
                                   flex-wrap
                                   gap-2"
                        >

                            <span
                                class="rounded-md
                                       border
                                       border-slate-200
                                       bg-white
                                       px-2.5
                                       py-1
                                       font-mono
                                       text-[10px]
                                       text-slate-500
                                       dark:border-white/[0.06]
                                       dark:bg-white/[0.025]
                                       dark:text-slate-500"
                            >
                                STEAM
                            </span>

                            <span
                                class="rounded-md
                                       border
                                       border-slate-200
                                       bg-white
                                       px-2.5
                                       py-1
                                       font-mono
                                       text-[10px]
                                       text-slate-500
                                       dark:border-white/[0.06]
                                       dark:bg-white/[0.025]
                                       dark:text-slate-500"
                            >
                                PROTON
                            </span>

                        </div>

                    </article>


                    <!-- =================================================
                         DECLARATIVE
                         ================================================= -->

                    <article
                        class="group
                               relative
                               overflow-hidden
                               rounded-2xl
                               border
                               border-slate-200
                               bg-slate-50
                               p-7
                               transition-all
                               duration-300
                               hover:-translate-y-1
                               hover:border-[#00b0f0]/35
                               hover:bg-white
                               dark:border-white/[0.07]
                               dark:bg-white/[0.025]
                               dark:hover:border-[#00b0f0]/30
                               dark:hover:bg-white/[0.045]"
                    >

                        <div
                            class="absolute
                                   left-0
                                   top-0
                                   h-px
                                   w-0
                                   bg-[#00b0f0]
                                   transition-all
                                   duration-500
                                   group-hover:w-full"
                        ></div>


                        <div
                            class="mb-6
                                   flex
                                   items-start
                                   justify-between"
                        >

                            <div
                                class="flex
                                       h-11
                                       w-11
                                       items-center
                                       justify-center
                                       rounded-xl
                                       border
                                       border-[#00b0f0]/15
                                       bg-[#00b0f0]/[0.07]"
                            >

                                <svg
                                    class="h-5 w-5 text-[#00b0f0]"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >

                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M8 7V3m8 4V3M5 11h14M5 5h14a2 2 0 012 2v12a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2z"
                                    ></path>

                                </svg>

                            </div>


                            <span
                                class="font-mono
                                       text-[10px]
                                       font-bold
                                       tracking-[0.2em]
                                       text-slate-400
                                       dark:text-slate-600"
                            >
                                03
                            </span>

                        </div>


                        <h3
                            class="mb-3
                                   text-xl
                                   font-bold
                                   text-slate-900
                                   dark:text-white"
                        >
                            Declarative
                        </h3>


                        <p
                            class="text-sm
                                   leading-6
                                   text-slate-500
                                   dark:text-slate-400"
                        >
                            Your system should be reproducible instead
                            of being a collection of undocumented manual
                            changes. Configuration becomes part of the
                            operating system itself.
                        </p>


                        <div
                            class="mt-6
                                   flex
                                   flex-wrap
                                   gap-2"
                        >

                            <span
                                class="rounded-md
                                       border
                                       border-slate-200
                                       bg-white
                                       px-2.5
                                       py-1
                                       font-mono
                                       text-[10px]
                                       text-slate-500
                                       dark:border-white/[0.06]
                                       dark:bg-white/[0.025]
                                       dark:text-slate-500"
                            >
                                REPRODUCIBLE
                            </span>

                            <span
                                class="rounded-md
                                       border
                                       border-slate-200
                                       bg-white
                                       px-2.5
                                       py-1
                                       font-mono
                                       text-[10px]
                                       text-slate-500
                                       dark:border-white/[0.06]
                                       dark:bg-white/[0.025]
                                       dark:text-slate-500"
                            >
                                DECLARATIVE
                            </span>

                        </div>

                    </article>


                    <!-- =================================================
                         NIRI + NOCTALIA
                         ================================================= -->

                    <article
                        class="group
                               relative
                               overflow-hidden
                               rounded-2xl
                               border
                               border-slate-200
                               bg-slate-50
                               p-7
                               transition-all
                               duration-300
                               hover:-translate-y-1
                               hover:border-[#00b0f0]/35
                               hover:bg-white
                               dark:border-white/[0.07]
                               dark:bg-white/[0.025]
                               dark:hover:border-[#00b0f0]/30
                               dark:hover:bg-white/[0.045]"
                    >

                        <div
                            class="absolute
                                   left-0
                                   top-0
                                   h-px
                                   w-0
                                   bg-[#00b0f0]
                                   transition-all
                                   duration-500
                                   group-hover:w-full"
                        ></div>


                        <div
                            class="mb-6
                                   flex
                                   items-start
                                   justify-between"
                        >

                            <div
                                class="flex
                                       h-11
                                       w-11
                                       items-center
                                       justify-center
                                       rounded-xl
                                       border
                                       border-[#00b0f0]/15
                                       bg-[#00b0f0]/[0.07]"
                            >

                                <svg
                                    class="h-5 w-5 text-[#00b0f0]"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >

                                    <rect
                                        x="3"
                                        y="4"
                                        width="18"
                                        height="16"
                                        rx="2"
                                        stroke-width="2"
                                    ></rect>

                                    <path
                                        d="M3 9h18M9 9v11"
                                        stroke-width="2"
                                    ></path>

                                </svg>

                            </div>


                            <span
                                class="font-mono
                                       text-[10px]
                                       font-bold
                                       tracking-[0.2em]
                                       text-slate-400
                                       dark:text-slate-600"
                            >
                                04
                            </span>

                        </div>


                        <h3
                            class="mb-3
                                   text-xl
                                   font-bold
                                   text-slate-900
                                   dark:text-white"
                        >
                            Niri + Noctalia
                        </h3>


                        <p
                            class="text-sm
                                   leading-6
                                   text-slate-500
                                   dark:text-slate-400"
                        >
                            A modern Wayland desktop built around
                            scrollable tiling with Niri and a focused
                            desktop shell powered by Noctalia.
                        </p>


                        <div
                            class="mt-6
                                   flex
                                   flex-wrap
                                   gap-2"
                        >

                            <span
                                class="rounded-md
                                       border
                                       border-slate-200
                                       bg-white
                                       px-2.5
                                       py-1
                                       font-mono
                                       text-[10px]
                                       text-slate-500
                                       dark:border-white/[0.06]
                                       dark:bg-white/[0.025]
                                       dark:text-slate-500"
                            >
                                WAYLAND
                            </span>

                            <span
                                class="rounded-md
                                       border
                                       border-slate-200
                                       bg-white
                                       px-2.5
                                       py-1
                                       font-mono
                                       text-[10px]
                                       text-slate-500
                                       dark:border-white/[0.06]
                                       dark:bg-white/[0.025]
                                       dark:text-slate-500"
                            >
                                NIRI
                            </span>

                            <span
                                class="rounded-md
                                       border
                                       border-slate-200
                                       bg-white
                                       px-2.5
                                       py-1
                                       font-mono
                                       text-[10px]
                                       text-slate-500
                                       dark:border-white/[0.06]
                                       dark:bg-white/[0.025]
                                       dark:text-slate-500"
                            >
                                NOCTALIA
                            </span>

                        </div>

                    </article>

                </div>

            </div>

        </section>


        <!-- =========================================================
             MODAL
             ========================================================= -->

        <div
            id="veloxDownloadModal"
            class="fixed
                   inset-0
                   z-[9999]
                   hidden
                   items-center
                   justify-center
                   bg-black/60
                   p-4
                   backdrop-blur-md"
        >

            <div
                class="relative
                       w-full
                       max-w-lg
                       overflow-hidden
                       rounded-3xl
                       border
                       border-slate-200
                       bg-white
                       p-8
                       text-center
                       shadow-2xl
                       dark:border-white/[0.08]
                       dark:bg-[#0b111c]"
            >

                <div
                    class="pointer-events-none
                           absolute
                           left-1/2
                           top-0
                           h-56
                           w-80
                           -translate-x-1/2
                           bg-[radial-gradient(ellipse_at_center,rgba(0,176,240,0.10),transparent_70%)]"
                ></div>


                <div
                    class="relative
                           mx-auto
                           mb-6
                           flex
                           h-16
                           w-16
                           items-center
                           justify-center
                           rounded-2xl
                           border
                           border-[#00b0f0]/20
                           bg-[#00b0f0]/[0.07]"
                >

                    <svg
                        width="32"
                        height="32"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="#00b0f0"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >

                        <circle
                            cx="12"
                            cy="12"
                            r="10"
                        ></circle>

                        <polyline
                            points="12 6 12 12 16 14"
                        ></polyline>

                    </svg>

                </div>


                <h2
                    class="mb-4
                           text-2xl
                           font-bold
                           text-slate-900
                           dark:text-white
                           md:text-3xl"
                >
                    Under Restructuring
                </h2>


                <div
                    class="mb-8
                           space-y-4
                           text-slate-500
                           dark:text-slate-400"
                >

                    <p class="text-base leading-7">
                        The upcoming generation of VeloxOS is being
                        rebuilt from the ground up.
                    </p>


                    <p
                        class="rounded-xl
                               border
                               border-[#00b0f0]/10
                               bg-[#00b0f0]/[0.04]
                               px-4
                               py-3
                               text-sm
                               font-semibold
                               text-[#00b0f0]"
                    >
                        Concept phase for the new architecture active
                    </p>

                </div>


                <button
                    onclick="closeVeloxModal()"
                    class="w-full
                           rounded-xl
                           border
                           border-slate-200
                           bg-slate-50
                           py-3
                           text-xs
                           font-semibold
                           uppercase
                           tracking-[0.18em]
                           text-slate-500
                           transition-all
                           hover:border-slate-300
                           hover:bg-slate-100
                           hover:text-slate-900
                           dark:border-white/[0.08]
                           dark:bg-white/[0.03]
                           dark:text-slate-400
                           dark:hover:border-white/[0.15]
                           dark:hover:bg-white/[0.06]
                           dark:hover:text-white"
                >
                    Close
                </button>

            </div>

        </div>


        <!-- =========================================================
             SCRIPT
             ========================================================= -->

        <script is:inline>

            function openVeloxModal() {

                const modal =
                    document.getElementById("veloxDownloadModal");

                if (!modal) return;

                modal.classList.remove("hidden");
                modal.style.display = "flex";

                document.body.style.overflow = "hidden";
            }


            function closeVeloxModal() {

                const modal =
                    document.getElementById("veloxDownloadModal");

                if (!modal) return;

                modal.classList.add("hidden");
                modal.style.display = "none";

                document.body.style.overflow = "";
            }


            window.addEventListener("click", function(event) {

                const modal =
                    document.getElementById("veloxDownloadModal");

                if (
                    modal &&
                    event.target === modal
                ) {

                    closeVeloxModal();

                }

            });


            window.addEventListener("keydown", function(event) {

                if (event.key === "Escape") {

                    closeVeloxModal();

                }

            });

        </script>

    </div>

</Layout>
