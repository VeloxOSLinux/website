---
import Layout from '../layouts/MainLayout.astro';
---

<Layout title="VeloxOS - Minimal. Fast. Yours.">

    <div id="page-content">

        <!-- =========================================================
             PROJECT REBOOT BANNER
             ========================================================= -->

        <div
            class="w-full
                   border-b
                   border-white/[0.06]
                   bg-[#080d16]/80
                   backdrop-blur-xl
                   px-6
                   py-3.5"
        >

            <div
                class="mx-auto
                       flex
                       max-w-6xl
                       flex-col
                       items-center
                       justify-center
                       gap-2
                       text-center
                       sm:flex-row"
            >

                <span
                    class="rounded
                           border
                           border-amber-400/20
                           bg-amber-400/[0.07]
                           px-2.5
                           py-1
                           text-[10px]
                           font-bold
                           uppercase
                           tracking-[0.15em]
                           text-amber-400"
                >
                    Project Reboot
                </span>

                <p
                    class="text-xs
                           text-slate-400
                           sm:text-sm"
                >
                    <strong class="font-semibold text-slate-200">
                        VeloxOS is stepping up a gear!
                    </strong>
                    <span class="ml-1">
                        We are completely restructuring the distribution.
                    </span>
                </p>

            </div>

        </div>


        <!-- =========================================================
             HERO
             ========================================================= -->

        <section
            class="relative
                   isolate
                   overflow-hidden
                   bg-[#070c16]
                   px-6
                   pb-28
                   pt-24
                   md:pb-36
                   md:pt-32"
        >

            <!-- =====================================================
                 CLEAN BACKGROUND
                 No blurred divs — only radial gradients.
                 ===================================================== -->

            <div
                class="pointer-events-none
                       absolute
                       inset-0
                       -z-10
                       bg-[radial-gradient(ellipse_65%_55%_at_50%_8%,rgba(0,176,240,0.115),transparent_68%),radial-gradient(ellipse_55%_55%_at_100%_100%,rgba(0,119,204,0.045),transparent_72%)]"
            ></div>


            <!-- Very subtle top vignette -->

            <div
                class="pointer-events-none
                       absolute
                       inset-x-0
                       top-0
                       -z-10
                       h-40
                       bg-gradient-to-b
                       from-[#0b1725]/40
                       to-transparent"
            ></div>


            <!-- =====================================================
                 HERO CONTENT
                 ===================================================== -->

            <div
                class="relative
                       mx-auto
                       max-w-5xl
                       text-center"
            >

                <!-- =================================================
                     LOGO
                     ================================================= -->

                <div
                    class="mb-12
                           flex
                           justify-center
                           md:mb-14"
                >

                    <img
                        src="https://wiki.veloxos.org/_astro/new_logo.CxzxC9pm_2vCcGx.webp"
                        alt="VeloxOS"
                        class="relative
                               h-32
                               w-auto
                               object-contain
                               drop-shadow-[0_0_35px_rgba(0,176,240,0.18)]
                               md:h-48
                               lg:h-52"
                    />

                </div>


                <!-- =================================================
                     TAGLINE
                     ================================================= -->

                <p
                    class="mb-7
                           text-2xl
                           font-semibold
                           leading-tight
                           tracking-tight
                           text-slate-100
                           md:text-3xl"
                >

                    <span class="text-[#00b0f0]">
                        Minimal.
                    </span>

                    Fast. Yours.

                </p>


                <!-- =================================================
                     DESCRIPTION
                     ================================================= -->

                <p
                    class="mx-auto
                           mb-10
                           max-w-2xl
                           text-base
                           leading-7
                           text-slate-400
                           md:text-lg
                           md:leading-8"
                >

                    <span
                        class="font-semibold
                               text-slate-200"
                    >
                        VeloxOS
                    </span>

                    is a performance-driven Linux distribution built
                    on reproducible system properties. Designed for
                    gamers and power users, it delivers a modern
                    software stack and extreme system responsiveness
                    — without compromising on stability or control.

                </p>


                <!-- =================================================
                     ACTIONS
                     ================================================= -->

                <div
                    class="flex
                           flex-col
                           items-center
                           justify-center
                           gap-3
                           sm:flex-row"
                >

                    <!-- Primary -->

                    <button
                        onclick="openVeloxModal()"
                        class="flex
                               w-full
                               items-center
                               justify-center
                               gap-2
                               rounded-xl
                               bg-[#00b0f0]
                               px-7
                               py-3.5
                               text-sm
                               font-bold
                               text-white
                               shadow-[0_8px_30px_rgba(0,176,240,0.22)]
                               transition-all
                               duration-300
                               hover:-translate-y-0.5
                               hover:bg-[#00c8ff]
                               hover:shadow-[0_10px_35px_rgba(0,176,240,0.32)]
                               sm:w-auto"
                    >

                        <svg
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >

                            <path
                                d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
                            ></path>

                            <polyline
                                points="7 10 12 15 17 10"
                            ></polyline>

                            <line
                                x1="12"
                                y1="15"
                                x2="12"
                                y2="3"
                            ></line>

                        </svg>

                        Try VeloxOS (ISO)

                    </button>


                    <!-- Secondary -->

                    <a
                        href="#why-veloxos"
                        class="flex
                               w-full
                               items-center
                               justify-center
                               rounded-xl
                               border
                               border-white/[0.12]
                               bg-white/[0.035]
                               px-7
                               py-3.5
                               text-sm
                               font-semibold
                               text-slate-200
                               transition-all
                               duration-300
                               hover:border-[#00b0f0]/40
                               hover:bg-white/[0.06]
                               sm:w-auto"
                    >
                        Learn More
                    </a>

                </div>

            </div>


            <!-- =====================================================
                 HERO BOTTOM FADE
                 ===================================================== -->

            <div
                class="pointer-events-none
                       absolute
                       inset-x-0
                       bottom-0
                       -z-10
                       h-40
                       bg-gradient-to-b
                       from-transparent
                       to-[#070c16]"
            ></div>

        </section>


        <!-- =========================================================
             WHY VELOXOS
             ========================================================= -->

        <section
            id="why-veloxos"
            class="relative
                   overflow-hidden
                   bg-[#070c16]
                   px-6
                   py-24
                   md:py-32"
        >

            <!-- Extremely subtle section glow -->

            <div
                class="pointer-events-none
                       absolute
                       left-1/2
                       top-0
                       h-[500px]
                       w-[900px]
                       -translate-x-1/2
                       bg-[radial-gradient(ellipse_at_center,rgba(0,176,240,0.045),transparent_68%)]"
            ></div>


            <div
                class="relative
                       mx-auto
                       max-w-6xl"
            >

                <!-- =================================================
                     SECTION HEADER
                     ================================================= -->

                <div
                    class="mb-14
                           text-center
                           md:mb-16"
                >

                    <div
                        class="mb-5
                               inline-flex
                               items-center
                               rounded-full
                               border
                               border-[#00b0f0]/20
                               bg-[#00b0f0]/[0.04]
                               px-3
                               py-1.5
                               text-[10px]
                               font-bold
                               uppercase
                               tracking-[0.2em]
                               text-[#00b0f0]"
                    >
                        Why VeloxOS
                    </div>


                    <h2
                        class="mb-4
                               text-3xl
                               font-extrabold
                               tracking-tight
                               text-white
                               md:text-5xl"
                    >
                        Built with purpose.
                    </h2>


                    <p
                        class="mx-auto
                               max-w-2xl
                               text-base
                               leading-7
                               text-slate-500
                               md:text-lg"
                    >
                        The perfect balance between extreme performance
                        and reliability.
                    </p>

                </div>


                <!-- =================================================
                     FEATURE GRID
                     ================================================= -->

                <div
                    class="grid
                           gap-4
                           md:grid-cols-3"
                >


                    <!-- =================================================
                         FEATURE 1
                         ================================================= -->

                    <div
                        class="group
                               relative
                               overflow-hidden
                               rounded-2xl
                               border
                               border-white/[0.07]
                               bg-white/[0.025]
                               p-7
                               transition-all
                               duration-300
                               hover:-translate-y-1
                               hover:border-[#00b0f0]/30
                               hover:bg-white/[0.04]"
                    >

                        <!-- Accent -->

                        <div
                            class="absolute
                                   left-0
                                   top-0
                                   h-px
                                   w-0
                                   bg-[#00b0f0]
                                   transition-all
                                   duration-500
                                   group-hover:w-full"
                        ></div>


                        <div
                            class="mb-6
                                   flex
                                   h-11
                                   w-11
                                   items-center
                                   justify-center
                                   rounded-xl
                                   border
                                   border-[#00b0f0]/15
                                   bg-[#00b0f0]/[0.07]"
                        >

                            <svg
                                class="h-5 w-5 text-[#00b0f0]"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >

                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M13 10V3L4 14h7v7l9-11h-7z"
                                ></path>

                            </svg>

                        </div>


                        <h3
                            class="mb-3
                                   text-lg
                                   font-bold
                                   text-white"
                        >
                            Tuned for Speed
                        </h3>


                        <p
                            class="text-sm
                                   leading-6
                                   text-slate-500"
                        >
                            Powered by custom kernel tweaks, we minimize
                            latency and squeeze the maximum performance
                            out of your gaming hardware.
                        </p>

                    </div>


                    <!-- =================================================
                         FEATURE 2
                         ================================================= -->

                    <div
                        class="group
                               relative
                               overflow-hidden
                               rounded-2xl
                               border
                               border-white/[0.07]
                               bg-white/[0.025]
                               p-7
                               transition-all
                               duration-300
                               hover:-translate-y-1
                               hover:border-[#00b0f0]/30
                               hover:bg-white/[0.04]"
                    >

                        <div
                            class="absolute
                                   left-0
                                   top-0
                                   h-px
                                   w-0
                                   bg-[#00b0f0]
                                   transition-all
                                   duration-500
                                   group-hover:w-full"
                        ></div>


                        <div
                            class="mb-6
                                   flex
                                   h-11
                                   w-11
                                   items-center
                                   justify-center
                                   rounded-xl
                                   border
                                   border-[#00b0f0]/15
                                   bg-[#00b0f0]/[0.07]"
                        >

                            <svg
                                class="h-5 w-5 text-[#00b0f0]"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >

                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z"
                                ></path>

                            </svg>

                        </div>


                        <h3
                            class="mb-3
                                   text-lg
                                   font-bold
                                   text-white"
                        >
                            Zero Configuration Required
                        </h3>


                        <p
                            class="text-sm
                                   leading-6
                                   text-slate-500"
                        >
                            Save yourself hours of manual setup.
                            Essential tools like
                            <span class="font-medium text-slate-300">
                                Steam, ProtonUp-Qt, and ZRAM optimizations
                            </span>
                            are baked right into the system.
                        </p>

                    </div>


                    <!-- =================================================
                         FEATURE 3
                         ================================================= -->

                    <div
                        class="group
                               relative
                               overflow-hidden
                               rounded-2xl
                               border
                               border-white/[0.07]
                               bg-white/[0.025]
                               p-7
                               transition-all
                               duration-300
                               hover:-translate-y-1
                               hover:border-[#00b0f0]/30
                               hover:bg-white/[0.04]"
                    >

                        <div
                            class="absolute
                                   left-0
                                   top-0
                                   h-px
                                   w-0
                                   bg-[#00b0f0]
                                   transition-all
                                   duration-500
                                   group-hover:w-full"
                        ></div>


                        <div
                            class="mb-6
                                   flex
                                   h-11
                                   w-11
                                   items-center
                                   justify-center
                                   rounded-xl
                                   border
                                   border-[#00b0f0]/15
                                   bg-[#00b0f0]/[0.07]"
                        >

                            <svg
                                class="h-5 w-5 text-[#00b0f0]"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >

                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 00-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                                ></path>

                            </svg>

                        </div>


                        <h3
                            class="mb-3
                                   text-lg
                                   font-bold
                                   text-white"
                        >
                            100% Secure via Snapshots
                        </h3>


                        <p
                            class="text-sm
                                   leading-6
                                   text-slate-500"
                        >
                            No more broken updates. Your entire OS is
                            backed up via snapshots. If something fails,
                            instantly rollback to a working previous state.
                        </p>

                    </div>

                </div>

            </div>

        </section>


        <!-- =========================================================
             DOWNLOAD MODAL
             ========================================================= -->

        <div
            id="veloxDownloadModal"
            class="hidden
                   fixed
                   inset-0
                   z-[9999]
                   items-center
                   justify-center
                   bg-black/75
                   p-4
                   backdrop-blur-md"
        >

            <div
                class="relative
                       w-full
                       max-w-lg
                       overflow-hidden
                       rounded-3xl
                       border
                       border-white/[0.08]
                       bg-[#0b111c]
                       p-8
                       text-center
                       shadow-2xl"
            >

                <!-- Modal glow -->

                <div
                    class="pointer-events-none
                           absolute
                           left-1/2
                           top-0
                           h-56
                           w-80
                           -translate-x-1/2
                           bg-[radial-gradient(ellipse_at_center,rgba(0,176,240,0.12),transparent_70%)]"
                ></div>


                <!-- Icon -->

                <div
                    class="relative
                           mx-auto
                           mb-6
                           flex
                           h-16
                           w-16
                           items-center
                           justify-center
                           rounded-2xl
                           border
                           border-[#00b0f0]/20
                           bg-[#00b0f0]/[0.07]"
                >

                    <svg
                        width="32"
                        height="32"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="#00b0f0"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >

                        <circle
                            cx="12"
                            cy="12"
                            r="10"
                        ></circle>

                        <polyline
                            points="12 6 12 12 16 14"
                        ></polyline>

                    </svg>

                </div>


                <h2
                    class="mb-4
                           text-2xl
                           font-bold
                           text-white
                           md:text-3xl"
                >
                    Under Restructuring
                </h2>


                <div
                    class="mb-8
                           space-y-4
                           text-slate-400"
                >

                    <p class="text-base leading-7">
                        The upcoming generation of VeloxOS is being
                        rebuilt from the ground up.
                    </p>


                    <p
                        class="rounded-xl
                               border
                               border-[#00b0f0]/10
                               bg-[#00b0f0]/[0.04]
                               px-4
                               py-3
                               text-sm
                               font-semibold
                               text-[#00b0f0]"
                    >
                        Concept phase for the new architecture active
                    </p>

                </div>


                <button
                    onclick="closeVeloxModal()"
                    class="w-full
                           rounded-xl
                           border
                           border-white/[0.08]
                           bg-white/[0.03]
                           py-3
                           text-xs
                           font-semibold
                           uppercase
                           tracking-[0.18em]
                           text-slate-400
                           transition-all
                           hover:border-white/[0.15]
                           hover:bg-white/[0.06]
                           hover:text-white"
                >
                    Close
                </button>

            </div>

        </div>


        <!-- =========================================================
             MODAL SCRIPT
             ========================================================= -->

        <script is:inline>

            function openVeloxModal() {

                const modal =
                    document.getElementById("veloxDownloadModal");

                if (!modal) return;

                modal.classList.remove("hidden");

                modal.style.display = "flex";

                document.body.style.overflow = "hidden";
            }


            function closeVeloxModal() {

                const modal =
                    document.getElementById("veloxDownloadModal");

                if (!modal) return;

                modal.classList.add("hidden");

                modal.style.display = "none";

                document.body.style.overflow = "auto";
            }


            window.addEventListener("click", function(event) {

                const modal =
                    document.getElementById("veloxDownloadModal");

                if (
                    modal &&
                    event.target === modal
                ) {

                    closeVeloxModal();

                }

            });


            window.addEventListener("keydown", function(event) {

                if (event.key === "Escape") {

                    closeVeloxModal();

                }

            });

        </script>

    </div>

</Layout>
