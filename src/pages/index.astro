---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="VeloxOS | Minimal. Fast. Yours.">
    
    <!-- HERO SECTION (Asymmetric, Modern & Unique) -->
    <section class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden">
        <div class="max-w-6xl mx-auto px-6">
            
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                
                <!-- Left Column: Message & Actions -->
                <div class="lg:col-span-7 text-left">
                    
                    <!-- Dev-Style Status Badge -->
                    <div class="inline-flex items-center gap-2.5 px-3 py-1.5 rounded-md border border-white/10 bg-white/[0.03] font-mono text-xs mb-8">
                        <span class="w-2 h-2 rounded-full bg-[#00b0f0] animate-pulse"></span>
                        <span class="text-slate-400">PROJECT REBOOT:</span>
                        <span class="text-white font-semibold">Vanilla Arch Base</span>
                    </div>

                    <!-- Main Slogan -->
                    <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white mb-6 leading-[1.1]">
                        Minimal. <br class="hidden sm:inline" />
                        <span class="text-[#00b0f0]">Fast.</span> Yours.
                    </h1>

                    <!-- Description -->
                    <p class="text-slate-300 text-base sm:text-lg mb-8 leading-relaxed max-w-xl font-normal">
                        VeloxOS combines the independence of <strong class="text-white">Vanilla Arch Linux</strong> with fine-tuned system performance and a dedicated package infrastructure. No bloatware, no artificial layers.
                    </p>

                    <!-- CTAs -->
                    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
                        <button 
                            id="openStatusModal" 
                            class="inline-flex items-center justify-center gap-3 px-6 py-3.5 rounded-lg bg-[#00b0f0] hover:bg-[#0096ce] text-slate-950 font-bold transition-all duration-200 text-sm shadow-[0_0_20px_rgba(0,176,240,0.25)] hover:shadow-[0_0_30px_rgba(0,176,240,0.4)] cursor-pointer"
                        >
                            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            Reboot Status & Roadmap
                        </button>
                        
                        <a 
                            href="#architecture" 
                            class="inline-flex items-center justify-center px-6 py-3.5 rounded-lg border border-white/10 hover:border-white/25 text-slate-200 font-medium transition-all duration-200 bg-white/[0.02] hover:bg-white/[0.05] text-sm"
                        >
                            Explore Architecture
                        </a>
                    </div>

                    <!-- Micro Features List -->
                    <div class="mt-10 pt-8 border-t border-white/[0.06] grid grid-cols-3 gap-4 font-mono text-xs text-slate-400">
                        <div>
                            <span class="block text-white font-bold">100% Arch</span>
                            <span>Upstream Repos</span>
                        </div>
                        <div>
                            <span class="block text-[#00b0f0] font-bold">Custom Repo</span>
                            <span>Velox Utilities</span>
                        </div>
                        <div>
                            <span class="block text-white font-bold">Wayland</span>
                            <span>Niri Composer</span>
                        </div>
                    </div>

                </div>

                <!-- Right Column: Brand Visualizer (Interactive OS Spec Box) -->
                <div class="lg:col-span-5 relative">
                    <div class="relative rounded-2xl border border-white/10 bg-[#090d16] p-6 shadow-2xl overflow-hidden group">
                        
                        <!-- Header Bar of the OS Box -->
                        <div class="flex items-center justify-between pb-4 mb-4 border-b border-white/5 font-mono text-xs text-slate-400">
                            <div class="flex items-center gap-2">
                                <span class="w-3 h-3 rounded-full bg-red-500/80"></span>
                                <span class="w-3 h-3 rounded-full bg-yellow-500/80"></span>
                                <span class="w-3 h-3 rounded-full bg-green-500/80"></span>
                            </div>
                            <span class="text-slate-500">veloxos-fetch</span>
                        </div>

                        <!-- Logo Center Piece -->
                        <div class="py-6 flex justify-center">
                            <img 
                                src="https://wiki.veloxos.org/_astro/new_logo.CxzxC9pm_2vCcGx.webp" 
                                alt="VeloxOS Emblem" 
                                class="h-32 sm:h-40 w-auto object-contain drop-shadow-[0_10px_20px_rgba(0,176,240,0.2)] group-hover:scale-105 transition-transform duration-500" 
                            />
                        </div>

                        <!-- Custom Spec Box -->
                        <div class="bg-black/40 rounded-lg p-4 font-mono text-xs space-y-2 border border-white/5">
                            <div class="flex justify-between">
                                <span class="text-slate-500">OS</span>
                                <span class="text-white">VeloxOS x86_64</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-slate-500">Base</span>
                                <span class="text-slate-300">Arch Linux (Pure)</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-slate-500">WM / Shell</span>
                                <span class="text-[#00b0f0]">Niri Wayland</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-slate-500">Target</span>
                                <span class="text-slate-300">Low-Latency / Gaming</span>
                            </div>
                        </div>

                    </div>
                </div>

            </div>

        </div>
    </section>

    <!-- ARCHITECTURE SECTION -->
    <section id="architecture" class="py-20 border-t border-white/[0.06] bg-black/20 scroll-mt-20">
        <div class="max-w-6xl mx-auto px-6">
            
            <div class="mb-14">
                <span class="font-mono text-xs font-bold uppercase tracking-widest text-[#00b0f0]">
                    // ARCHITECTURE & PHILOSOPHOLOGY
                </span>
                <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white mt-3">
                    Pure Arch Linux. Uncompromisingly Tuned.
                </h2>
            </div>

            <!-- Grid with sharp edge aesthetics -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                
                <div class="p-8 rounded-xl border border-white/[0.08] bg-white/[0.01] hover:bg-white/[0.03] transition-colors">
                    <div class="font-mono text-xs text-[#00b0f0] mb-4">01. BASE</div>
                    <h3 class="text-lg font-bold text-white mb-2">100% Upstream Arch</h3>
                    <p class="text-slate-400 text-sm leading-relaxed">
                        No modified core packages. All updates arrive directly and untouched from the official Arch Linux repositories.
                    </p>
                </div>

                <div class="p-8 rounded-xl border border-white/[0.08] bg-white/[0.01] hover:bg-white/[0.03] transition-colors">
                    <div class="font-mono text-xs text-[#00b0f0] mb-4">02. PERFORMANCE</div>
                    <h3 class="text-lg font-bold text-white mb-2">Low-Latency Stack</h3>
                    <p class="text-slate-400 text-sm leading-relaxed">
                        Specifically tuned kernel parameters and graphics configs ensure minimal input latency and maximum frame rates for gaming.
                    </p>
                </div>

                <div class="p-8 rounded-xl border border-white/[0.08] bg-white/[0.01] hover:bg-white/[0.03] transition-colors">
                    <div class="font-mono text-xs text-[#00b0f0] mb-4">03. EXTENSIONS</div>
                    <h3 class="text-lg font-bold text-white mb-2">Custom Velox Repo</h3>
                    <p class="text-slate-400 text-sm leading-relaxed">
                        In-house system utilities, helper scripts, and fine-tuned desktop configs reside cleanly isolated in our own repository.
                    </p>
                </div>

            </div>

        </div>
    </section>

    <!-- STATUS MODAL -->
    <div id="statusModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-xl opacity-0 pointer-events-none transition-opacity duration-300">
        <div class="relative w-full max-w-lg bg-[#0c1017] border border-white/10 rounded-xl p-6 sm:p-8 shadow-2xl scale-95 transition-transform duration-300" id="statusModalContent">
            
            <button id="closeStatusModal" class="absolute top-5 right-5 text-slate-400 hover:text-white p-1 transition-colors" aria-label="Close">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12"></path></svg>
            </button>

            <div class="flex items-center gap-3.5 mb-5">
                <div class="w-10 h-10 rounded-lg bg-[#00b0f0]/10 border border-[#00b0f0]/30 text-[#00b0f0] flex items-center justify-center flex-shrink-0">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                </div>
                <div>
                    <h3 class="text-xl font-bold text-white">Project Reboot Status</h3>
                    <p class="font-mono text-xs text-[#00b0f0]">Vanilla Arch Migration</p>
                </div>
            </div>

            <p class="text-sm text-slate-300 mb-6 leading-relaxed">
                We are currently actively restructuring the distribution on top of Vanilla Arch Linux. Official ISO builds are in preparation. Track the current progress via our community channels:
            </p>

            <div class="flex flex-col gap-3">
                <a 
                    href="https://discord.gg/pgHSK8NGxG" 
                    target="_blank" 
                    class="flex items-center justify-between p-4 rounded-lg border border-white/10 bg-white/[0.02] hover:border-[#00b0f0] transition-colors group"
                >
                    <div class="flex items-center gap-3.5">
                        <svg width="20" height="20" fill="currentColor" class="text-slate-300 group-hover:text-[#00b0f0] transition-colors" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.006 14.006 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
                        <div>
                            <div class="text-sm font-semibold text-white group-hover:text-[#00b0f0] transition-colors">Discord Server</div>
                            <div class="text-xs text-slate-400">Dev updates & community discussions</div>
                        </div>
                    </div>
                    <span class="font-mono text-xs font-semibold px-2.5 py-1 rounded bg-[#00b0f0]/10 text-[#00b0f0]">Community</span>
                </a>

                <a 
                    href="https://github.com/VeloxOSLinux" 
                    target="_blank" 
                    class="flex items-center justify-between p-4 rounded-lg border border-white/10 bg-white/[0.02] hover:border-[#00b0f0] transition-colors group"
                >
                    <div class="flex items-center gap-3.5">
                        <svg width="20" height="20" fill="currentColor" class="text-slate-300 group-hover:text-[#00b0f0] transition-colors" viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
                        <div>
                            <div class="text-sm font-semibold text-white group-hover:text-[#00b0f0] transition-colors">GitHub Organization</div>
                            <div class="text-xs text-slate-400">Repositories & PKGBUILDS</div>
                        </div>
                    </div>
                    <span class="font-mono text-xs font-semibold px-2.5 py-1 rounded bg-white/10 text-slate-300">Code</span>
                </a>
            </div>

            <div class="mt-6 text-center">
                <button id="closeStatusModalBtn" class="text-xs text-slate-400 hover:text-white underline cursor-pointer">
                    Close Window
                </button>
            </div>

        </div>
    </div>

    <script is:inline>
        const setupModal = () => {
            const openBtn = document.getElementById('openStatusModal');
            const closeBtn = document.getElementById('closeStatusModal');
            const closeBtnSecondary = document.getElementById('closeStatusModalBtn');
            const modal = document.getElementById('statusModal');
            const modalContent = document.getElementById('statusModalContent');

            if (!openBtn || !modal) return;

            const openModal = () => {
                modal.classList.remove('opacity-0', 'pointer-events-none');
                modalContent?.classList.remove('scale-95');
                modalContent?.classList.add('scale-100');
            };

            const closeModal = () => {
                modal.classList.add('opacity-0', 'pointer-events-none');
                modalContent?.classList.remove('scale-100');
                modalContent?.classList.add('scale-95');
            };

            openBtn.onclick = openModal;
            closeBtn.onclick = closeModal;
            closeBtnSecondary.onclick = closeModal;

            modal.onclick = (e) => {
                if (e.target === modal) closeModal();
            };
        };

        setupModal();
        document.addEventListener('astro:after-swap', setupModal);
    </script>
</MainLayout>
