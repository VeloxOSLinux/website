---
import Layout from '../layouts/MainLayout.astro';
---

<Layout title="VeloxOS - Minimal. Fast. Yours.">

    <div id="page-content">

        <!-- =========================================================
             PROJECT REBOOT BANNER
             ========================================================= -->

        <div
            class="w-full
                   bg-gradient-to-r
                   from-amber-500/10
                   via-[#00b0f0]/10
                   to-amber-500/10
                   border-b
                   border-amber-500/20
                   py-4
                   px-6
                   transition-colors
                   duration-300"
        >

            <div
                class="max-w-6xl
                       mx-auto
                       flex
                       flex-col
                       sm:flex-row
                       items-center
                       justify-between
                       gap-4
                       text-center
                       sm:text-left"
            >

                <div
                    class="flex
                           items-center
                           gap-3
                           flex-col
                           sm:flex-row"
                >

                    <span
                        class="px-2.5
                               py-1
                               text-xs
                               font-bold
                               uppercase
                               tracking-wider
                               text-amber-600
                               dark:text-amber-400
                               bg-amber-500/10
                               rounded
                               border
                               border-amber-500/20
                               animate-pulse"
                    >
                        Project Reboot
                    </span>

                    <p
                        class="text-sm
                               text-slate-700
                               dark:text-slate-300
                               font-medium"
                    >
                        <strong class="text-slate-900 dark:text-white">
                            VeloxOS is stepping up a gear!
                        </strong>
                        We are completely restructuring the distribution.
                    </p>

                </div>

            </div>

        </div>


        <!-- =========================================================
             HERO
             ========================================================= -->

        <section
            class="relative
                   pt-20
                   md:pt-28
                   pb-28
                   md:pb-36
                   overflow-hidden
                   transition-colors
                   duration-300"
        >

            <!-- Background glow -->
            <div
                class="absolute
                       inset-0
                       overflow-hidden
                       pointer-events-none"
            >

                <div
                    class="absolute
                           left-1/2
                           -translate-x-1/2
                           -top-32
                           w-[500px]
                           md:w-[800px]
                           h-[400px]
                           md:h-[550px]
                           bg-[#00b0f0]/10
                           blur-[120px]
                           md:blur-[160px]
                           rounded-full"
                ></div>

                <div
                    class="absolute
                           left-1/2
                           -translate-x-1/2
                           top-[500px]
                           w-[600px]
                           md:w-[1000px]
                           h-[300px]
                           bg-blue-700/5
                           blur-[120px]
                           rounded-full"
                ></div>

                <!-- subtle decorative line -->
                <div
                    class="absolute
                           left-1/2
                           top-[300px]
                           -translate-x-1/2
                           w-[900px]
                           h-px
                           bg-gradient-to-r
                           from-transparent
                           via-[#00b0f0]/10
                           to-transparent"
                ></div>

            </div>


            <div
                class="relative
                       max-w-6xl
                       mx-auto
                       px-6"
            >

                <!-- =================================================
                     BRAND / LOGO
                     ================================================= -->

                <div class="text-center">

                    <div
                        class="flex
                               justify-center
                               mb-10"
                    >

                        <!--
                            VeloxOS logo
                            Inline SVG so no external image file
                            is required.
                        -->

                        <div
                            class="relative
                                   group
                                   drop-shadow-[0_0_35px_rgba(0,176,240,0.22)]"
                        >

                            <div
                                class="absolute
                                       inset-0
                                       bg-[#00b0f0]/10
                                       blur-3xl
                                       rounded-full
                                       scale-150"
                            ></div>

                            <div class="flex justify-center mb-10">
    <img
        src="/NewLogo_wText.webp"
        alt="VeloxOS"
        class="w-auto
               h-24
               md:h-32
               object-contain
               drop-shadow-[0_0_35px_rgba(0,176,240,0.22)]"
    />
</div>

                                <!-- Main V -->
                                <path
                                    d="M22 24
                                       L52 24
                                       L82 102
                                       L112 24
                                       L142 24
                                       L98 136
                                       L68 136
                                       Z"
                                    fill="currentColor"
                                    class="text-slate-900 dark:text-white"
                                />

                                <!-- Blue speed element -->
                                <path
                                    d="M91 48
                                       L128 48
                                       L108 66
                                       L126 66
                                       L86 106
                                       L96 78
                                       L76 78
                                       Z"
                                    fill="#00b0f0"
                                />

                                <path
                                    d="M96 80
                                       L119 80
                                       L101 98
                                       L111 98
                                       L87 121
                                       L94 101
                                       L81 101
                                       Z"
                                    fill="#0077cc"
                                    opacity="0.9"
                                />

                            </svg>

                        </div>

                    </div>


                    <!-- =================================================
                         SLOGAN
                         ================================================= -->

                    <h1
                        class="text-5xl
                               md:text-7xl
                               lg:text-8xl
                               font-extrabold
                               tracking-tight
                               leading-[1.02]
                               mb-8
                               text-slate-900
                               dark:text-white"
                    >

                        <span class="text-[#00b0f0]">
                            Minimal.
                        </span>

                        Fast.
                        Yours.

                    </h1>


                    <!-- =================================================
                         DESCRIPTION
                         ================================================= -->

                    <p
                        class="mx-auto
                               max-w-3xl
                               text-lg
                               md:text-xl
                               text-slate-600
                               dark:text-slate-400
                               leading-relaxed
                               mb-10"
                    >

                        <span
                            class="text-slate-900
                                   dark:text-white
                                   font-semibold"
                        >
                            VeloxOS
                        </span>

                        is a performance-driven Linux distribution built
                        on reproducible system properties. Designed for
                        gamers and power users, it delivers a modern
                        software stack and extreme system responsiveness —
                        without compromising on stability or control.

                    </p>


                    <!-- =================================================
                         BUTTONS
                         ================================================= -->

                    <div
                        class="flex
                               flex-col
                               sm:flex-row
                               items-center
                               justify-center
                               gap-4
                               mb-20"
                    >

                        <button
                            onclick="openVeloxModal()"
                            class="w-full
                                   sm:w-auto
                                   px-8
                                   py-4
                                   bg-[#00b0f0]
                                   hover:bg-[#00d4ff]
                                   text-white
                                   font-bold
                                   rounded-xl
                                   transition-all
                                   transform
                                   hover:-translate-y-1
                                   shadow-[0_4px_25px_rgba(0,176,240,0.30)]
                                   hover:shadow-[0_8px_35px_rgba(0,176,240,0.40)]
                                   flex
                                   items-center
                                   justify-center
                                   gap-2
                                   cursor-pointer"
                        >

                            <svg
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path
                                    d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
                                ></path>

                                <polyline
                                    points="7 10 12 15 17 10"
                                ></polyline>

                                <line
                                    x1="12"
                                    y1="15"
                                    x2="12"
                                    y2="3"
                                ></line>

                            </svg>

                            Try VeloxOS (ISO)

                        </button>


                        <a
                            href="#why-veloxos"
                            class="w-full
                                   sm:w-auto
                                   px-8
                                   py-4
                                   bg-slate-100
                                   dark:bg-white/5
                                   hover:bg-slate-200
                                   dark:hover:bg-white/10
                                   text-slate-900
                                   dark:text-white
                                   font-semibold
                                   rounded-xl
                                   border
                                   border-slate-200
                                   dark:border-white/20
                                   transition-all
                                   hover:border-[#00b0f0]
                                   flex
                                   items-center
                                   justify-center"
                        >
                            Learn More
                        </a>

                    </div>

                </div>


                <!-- =================================================
                     SYSTEM / TERMINAL PREVIEW
                     ================================================= -->

                <div
                    class="relative
                           max-w-5xl
                           mx-auto"
                >

                    <!-- terminal glow -->

                    <div
                        class="absolute
                               -inset-1
                               bg-gradient-to-r
                               from-[#00b0f0]/30
                               via-blue-600/20
                               to-[#00b0f0]/30
                               rounded-3xl
                               blur-2xl
                               opacity-50"
                    ></div>


                    <!-- terminal -->

                    <div
                        class="relative
                               bg-white
                               dark:bg-[#080c12]
                               rounded-2xl
                               border
                               border-slate-200
                               dark:border-white/10
                               shadow-2xl
                               overflow-hidden
                               font-mono
                               text-sm
                               text-left"
                    >

                        <!-- Terminal header -->

                        <div
                            class="bg-slate-100
                                   dark:bg-white/[0.04]
                                   px-5
                                   py-3.5
                                   border-b
                                   border-slate-200
                                   dark:border-white/5
                                   flex
                                   items-center"
                        >

                            <div class="flex gap-1.5">

                                <div
                                    class="w-3
                                           h-3
                                           rounded-full
                                           bg-red-500/70"
                                ></div>

                                <div
                                    class="w-3
                                           h-3
                                           rounded-full
                                           bg-yellow-500/70"
                                ></div>

                                <div
                                    class="w-3
                                           h-3
                                           rounded-full
                                           bg-green-500/70"
                                ></div>

                            </div>

                            <span
                                class="text-slate-500
                                       dark:text-slate-400
                                       text-xs
                                       ml-4"
                            >
                                veloxos@veloxos ~
                            </span>

                        </div>


                        <!-- Terminal body -->

                        <div
                            class="p-6
                                   md:p-10"
                        >

                            <!-- command -->

                            <div
                                class="flex
                                       gap-2
                                       mb-7"
                            >

                                <span
                                    class="text-[#00b0f0]
                                           font-bold"
                                >
                                    ➜
                                </span>

                                <span
                                    class="text-slate-900
                                           dark:text-white"
                                >
                                    fastfetch
                                </span>

                            </div>


                            <!-- system information -->

                            <div
                                class="grid
                                       md:grid-cols-[220px_1fr]
                                       gap-8
                                       md:gap-12
                                       items-center"
                            >

                                <!-- Logo inside terminal -->

                                <div
                                    class="hidden
                                           md:flex
                                           justify-center
                                           items-center"
                                >

                                    <svg
                                        class="w-32
                                               h-32
                                               drop-shadow-[0_0_20px_rgba(0,176,240,0.25)]"
                                        viewBox="0 0 160 160"
                                        fill="none"
                                        xmlns="http://www.w3.org/2000/svg"
                                    >

                                        <path
                                            d="M22 24
                                               L52 24
                                               L82 102
                                               L112 24
                                               L142 24
                                               L98 136
                                               L68 136
                                               Z"
                                            fill="currentColor"
                                            class="text-slate-900 dark:text-white"
                                        />

                                        <path
                                            d="M91 48
                                               L128 48
                                               L108 66
                                               L126 66
                                               L86 106
                                               L96 78
                                               L76 78
                                               Z"
                                            fill="#00b0f0"
                                        />

                                        <path
                                            d="M96 80
                                               L119 80
                                               L101 98
                                               L111 98
                                               L87 121
                                               L94 101
                                               L81 101
                                               Z"
                                            fill="#0077cc"
                                        />

                                    </svg>

                                </div>


                                <!-- Information -->

                                <div
                                    class="grid
                                           grid-cols-1
                                           sm:grid-cols-2
                                           gap-x-10
                                           gap-y-3
                                           text-xs
                                           md:text-sm"
                                >

                                    <p>

                                        <span
                                            class="text-[#00b0f0]
                                                   font-semibold"
                                        >
                                            OS:
                                        </span>

                                        <span
                                            class="text-slate-700
                                                   dark:text-slate-300"
                                        >
                                            VeloxOS
                                        </span>

                                    </p>


                                    <p>

                                        <span
                                            class="text-[#00b0f0]
                                                   font-semibold"
                                        >
                                            Kernel:
                                        </span>

                                        <span
                                            class="text-slate-700
                                                   dark:text-slate-300"
                                        >
                                            Linux
                                        </span>

                                    </p>


                                    <p>

                                        <span
                                            class="text-[#00b0f0]
                                                   font-semibold"
                                        >
                                            Base:
                                        </span>

                                        <span
                                            class="text-slate-700
                                                   dark:text-slate-300"
                                        >
                                            NixOS
                                        </span>

                                    </p>


                                    <p>

                                        <span
                                            class="text-[#00b0f0]
                                                   font-semibold"
                                        >
                                            Compositor:
                                        </span>

                                        <span
                                            class="text-slate-700
                                                   dark:text-slate-300"
                                        >
                                            Niri Wayland
                                        </span>

                                    </p>


                                    <p>

                                        <span
                                            class="text-[#00b0f0]
                                                   font-semibold"
                                        >
                                            Shell:
                                        </span>

                                        <span
                                            class="text-slate-700
                                                   dark:text-slate-300"
                                        >
                                            Noctalia
                                        </span>

                                    </p>


                                    <p>

                                        <span
                                            class="text-[#00b0f0]
                                                   font-semibold"
                                        >
                                            Terminal:
                                        </span>

                                        <span
                                            class="text-slate-700
                                                   dark:text-slate-300"
                                        >
                                            Kitty
                                        </span>

                                    </p>

                                </div>

                            </div>


                            <!-- Fake system status -->

                            <div
                                class="mt-8
                                       pt-5
                                       border-t
                                       border-slate-200
                                       dark:border-white/5
                                       flex
                                       flex-col
                                       sm:flex-row
                                       sm:items-center
                                       sm:justify-between
                                       gap-3
                                       text-xs"
                            >

                                <div class="flex items-center gap-2">

                                    <span
                                        class="w-2
                                               h-2
                                               rounded-full
                                               bg-[#00b0f0]
                                               shadow-[0_0_8px_rgba(0,176,240,0.7)]"
                                    ></span>

                                    <span
                                        class="text-slate-500
                                               dark:text-slate-400"
                                    >
                                        system ready
                                    </span>

                                </div>

                                <div
                                    class="text-slate-400
                                           dark:text-slate-500"
                                >
                                    veloxos@veloxos:~$
                                    <span
                                        class="text-[#00b0f0]"
                                    >
                                        _
                                    </span>
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- =========================================================
             WHY VELOXOS
             ========================================================= -->

        <section
            id="why-veloxos"
            class="max-w-6xl
                   mx-auto
                   px-6
                   py-24
                   md:py-32"
        >

            <div
                class="text-center
                       mb-16"
            >

                <div
                    class="inline-flex
                           items-center
                           gap-2
                           px-3
                           py-1.5
                           rounded-full
                           border
                           border-[#00b0f0]/20
                           bg-[#00b0f0]/5
                           text-[#00b0f0]
                           text-xs
                           font-semibold
                           uppercase
                           tracking-widest
                           mb-6"
                >
                    Why VeloxOS
                </div>


                <h2
                    class="text-3xl
                           md:text-5xl
                           font-extrabold
                           mb-4
                           text-slate-900
                           dark:text-white
                           tracking-tight"
                >
                    Built with purpose.
                </h2>


                <p
                    class="text-slate-600
                           dark:text-slate-400
                           text-lg
                           max-w-2xl
                           mx-auto"
                >
                    The perfect balance between extreme performance
                    and reliability.
                </p>

            </div>


            <!-- Feature grid -->

            <div
                class="grid
                       md:grid-cols-3
                       gap-6"
            >

                <!-- Feature 1 -->

                <div
                    class="group
                           relative
                           bg-slate-50
                           dark:bg-white/[0.02]
                           border
                           border-slate-200
                           dark:border-white/10
                           p-8
                           rounded-[24px]
                           transition-all
                           duration-500
                           hover:-translate-y-2
                           hover:border-[#00b0f0]/50
                           shadow-sm
                           hover:shadow-2xl
                           hover:shadow-[#00b0f0]/10"
                >

                    <div
                        class="w-12
                               h-12
                               bg-[#00b0f0]/10
                               rounded-xl
                               flex
                               items-center
                               justify-center
                               mb-6
                               group-hover:scale-110
                               transition-transform
                               duration-500"
                    >

                        <svg
                            class="w-6
                                   h-6
                                   text-[#00b0f0]"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >

                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M13 10V3L4 14h7v7l9-11h-7z"
                            ></path>

                        </svg>

                    </div>


                    <h3
                        class="text-xl
                               font-bold
                               mb-4
                               text-slate-900
                               dark:text-white"
                    >
                        Tuned for Speed
                    </h3>


                    <p
                        class="text-slate-600
                               dark:text-slate-400
                               leading-relaxed
                               text-[15px]"
                    >
                        Powered by custom kernel tweaks, we minimize
                        latency and squeeze the maximum performance
                        out of your gaming hardware.
                    </p>

                </div>


                <!-- Feature 2 -->

                <div
                    class="group
                           relative
                           bg-slate-50
                           dark:bg-white/[0.02]
                           border
                           border-slate-200
                           dark:border-white/10
                           p-8
                           rounded-[24px]
                           transition-all
                           duration-500
                           hover:-translate-y-2
                           hover:border-[#00b0f0]/50
                           shadow-sm
                           hover:shadow-2xl
                           hover:shadow-[#00b0f0]/10"
                >

                    <div
                        class="w-12
                               h-12
                               bg-[#00b0f0]/10
                               rounded-xl
                               flex
                               items-center
                               justify-center
                               mb-6
                               group-hover:scale-110
                               transition-transform
                               duration-500"
                    >

                        <svg
                            class="w-6
                                   h-6
                                   text-[#00b0f0]"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >

                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z"
                            ></path>

                        </svg>

                    </div>


                    <h3
                        class="text-xl
                               font-bold
                               mb-4
                               text-slate-900
                               dark:text-white"
                    >
                        Zero Configuration Required
                    </h3>


                    <p
                        class="text-slate-600
                               dark:text-slate-400
                               leading-relaxed
                               text-[15px]"
                    >
                        Save yourself hours of manual setup. Essential
                        tools like
                        <span
                            class="text-[#00b0f0]
                                   font-medium"
                        >
                            Steam, ProtonUp-Qt, and ZRAM optimizations
                        </span>
                        are baked right into the system.
                    </p>

                </div>


                <!-- Feature 3 -->

                <div
                    class="group
                           relative
                           bg-slate-50
                           dark:bg-white/[0.02]
                           border
                           border-slate-200
                           dark:border-white/10
                           p-8
                           rounded-[24px]
                           transition-all
                           duration-500
                           hover:-translate-y-2
                           hover:border-[#00b0f0]/50
                           shadow-sm
                           hover:shadow-2xl
                           hover:shadow-[#00b0f0]/10"
                >

                    <div
                        class="w-12
                               h-12
                               bg-[#00b0f0]/10
                               rounded-xl
                               flex
                               items-center
                               justify-center
                               mb-6
                               group-hover:scale-110
                               transition-transform
                               duration-500"
                    >

                        <svg
                            class="w-6
                                   h-6
                                   text-[#00b0f0]"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >

                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 00-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                            ></path>

                        </svg>

                    </div>


                    <h3
                        class="text-xl
                               font-bold
                               mb-4
                               text-slate-900
                               dark:text-white"
                    >
                        100% Secure via Snapshots
                    </h3>


                    <p
                        class="text-slate-600
                               dark:text-slate-400
                               leading-relaxed
                               text-[15px]"
                    >
                        No more broken updates. Your entire OS is backed
                        up via snapshots. If something fails, instantly
                        rollback to a working previous state. Clean and
                        unbreakable.
                    </p>

                </div>

            </div>

        </section>


        <!-- =========================================================
             DOWNLOAD MODAL
             ========================================================= -->

        <div
            id="veloxDownloadModal"
            class="hidden
                   fixed
                   inset-0
                   z-[9999]
                   bg-black/80
                   backdrop-blur-md
                   items-center
                   justify-center
                   p-4"
        >

            <div
                class="bg-white
                       dark:bg-[#0d1117]
                       border
                       border-[#00b0f0]/30
                       p-8
                       rounded-[28px]
                       max-w-lg
                       w-full
                       text-center
                       shadow-2xl
                       relative
                       overflow-hidden"
            >

                <!-- Modal glow -->

                <div
                    class="absolute
                           -top-32
                           left-1/2
                           -translate-x-1/2
                           w-64
                           h-64
                           bg-[#00b0f0]/10
                           blur-[80px]
                           rounded-full
                           pointer-events-none"
                ></div>


                <!-- Icon -->

                <div
                    class="relative
                           w-20
                           h-20
                           bg-[#00b0f0]/10
                           rounded-2xl
                           flex
                           items-center
                           justify-center
                           mx-auto
                           mb-6"
                >

                    <svg
                        width="40"
                        height="40"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="#00b0f0"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >

                        <circle
                            cx="12"
                            cy="12"
                            r="10"
                        ></circle>

                        <polyline
                            points="12 6 12 12 16 14"
                        ></polyline>

                    </svg>

                </div>


                <h2
                    class="text-3xl
                           font-bold
                           text-slate-900
                           dark:text-white
                           mb-4"
                >
                    Under Restructuring
                </h2>


                <div
                    class="space-y-4
                           text-slate-600
                           dark:text-slate-400
                           mb-8"
                >

                    <p class="text-lg">
                        The upcoming generation of VeloxOS is being
                        rebuilt from the ground up.
                    </p>

                    <p
                        class="bg-[#00b0f0]/5
                               py-3
                               px-4
                               rounded-xl
                               border
                               border-[#00b0f0]/10
                               text-[#00b0f0]
                               font-semibold"
                    >
                        Concept phase for the new architecture active
                    </p>

                </div>


                <div class="flex flex-col gap-3">

                    <button
                        onclick="closeVeloxModal()"
                        class="w-full
                               py-3
                               text-slate-500
                               hover:text-slate-700
                               dark:hover:text-white
                               transition-colors
                               text-sm
                               font-medium
                               uppercase
                               tracking-widest"
                    >
                        Close
                    </button>

                </div>

            </div>

        </div>


        <!-- =========================================================
             MODAL SCRIPT
             ========================================================= -->

        <script is:inline>

            function openVeloxModal() {

                const modal =
                    document.getElementById("veloxDownloadModal");

                if (!modal) return;

                modal.classList.remove("hidden");

                modal.style.display = "flex";

                document.body.style.overflow = "hidden";
            }


            function closeVeloxModal() {

                const modal =
                    document.getElementById("veloxDownloadModal");

                if (!modal) return;

                modal.classList.add("hidden");

                modal.style.display = "none";

                document.body.style.overflow = "auto";
            }


            window.addEventListener("click", function(event) {

                const modal =
                    document.getElementById("veloxDownloadModal");

                if (
                    modal &&
                    event.target === modal
                ) {

                    closeVeloxModal();

                }

            });


            window.addEventListener("keydown", function(event) {

                if (event.key === "Escape") {

                    closeVeloxModal();

                }

            });

        </script>

    </div>

</Layout>
