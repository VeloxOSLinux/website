---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="VeloxOS | Reproducible, High-Performance Linux">
    
    <!-- HERO SECTION -->
    <section class="relative pt-16 pb-24 md:pt-24 md:pb-36 overflow-hidden">
        <div class="max-w-5xl mx-auto px-6 flex flex-col items-center text-center relative z-10">
            
            <!-- High-Tech Badge -->
            <div class="inline-flex items-center gap-3 px-4 py-1.5 rounded-full border border-[#00b0f0]/30 bg-[#00b0f0]/10 text-xs font-mono mb-8 text-slate-200 backdrop-blur-md">
                <span class="w-2 h-2 rounded-full bg-[#00b0f0] animate-pulse"></span>
                <span class="font-bold text-[#00b0f0] uppercase tracking-wider">Project Reboot</span>
                <span class="text-slate-400">|</span>
                <span class="text-slate-300">NixOS + Niri Architecture Migration</span>
            </div>

            <!-- Hero Brand Visual -->
            <div class="mb-10 relative group">
                <div class="absolute -inset-6 bg-[#00b0f0]/15 rounded-full blur-3xl group-hover:bg-[#00b0f0]/25 transition-all duration-700"></div>
                <img 
                    src="/NewLogo_wText.webp" 
                    alt="VeloxOS Emblem" 
                    class="relative h-32 sm:h-40 md:h-48 w-auto object-contain drop-shadow-[0_12px_30px_rgba(0,176,240,0.25)]" 
                />
            </div>

            <!-- Headline -->
            <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-white mb-6 leading-none">
                Minimal. <span class="text-[#00b0f0]">Fast.</span> Yours.
            </h1>

            <!-- Subtitle -->
            <p class="max-w-2xl text-base sm:text-lg text-slate-300 mb-10 leading-relaxed font-normal">
                A performance-driven Linux distribution built on declarative system states. Engineered for low-latency gaming, power users, and total system control — powered by Wayland and reproducible Nix flakes.
            </p>

            <!-- Primary CTAs -->
            <div class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto">
                <button 
                    id="openStatusModal" 
                    class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl bg-[#00b0f0] hover:bg-[#0090c8] text-slate-950 font-bold transition-all duration-200 shadow-[0_0_25px_rgba(0,176,240,0.3)] hover:shadow-[0_0_35px_rgba(0,176,240,0.5)] hover:-translate-y-0.5 cursor-pointer text-sm"
                >
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    Reboot Status & Roadmap
                </button>
                
                <a 
                    href="#architecture" 
                    class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-xl border border-white/15 hover:border-[#00b0f0] text-slate-200 font-semibold transition-all duration-200 bg-white/[0.03] hover:bg-white/[0.08] backdrop-blur-md hover:-translate-y-0.5 text-sm"
                >
                    Explore Architecture
                </a>
            </div>

        </div>
    </section>

    <!-- TECH SPECS STRIP (Wirkt extrem professionell) -->
    <section class="border-y border-white/[0.06] bg-white/[0.01] py-8 backdrop-blur-sm">
        <div class="max-w-6xl mx-auto px-6 grid grid-cols-2 md:grid-cols-4 gap-6 text-center font-mono text-xs">
            <div class="p-4 rounded-xl border border-white/5 bg-white/[0.01]">
                <div class="text-slate-500 mb-1">BASE CORE</div>
                <div class="text-white font-bold text-sm">NixOS Reproducible</div>
            </div>
            <div class="p-4 rounded-xl border border-white/5 bg-white/[0.01]">
                <div class="text-slate-500 mb-1">WINDOW MANAGER</div>
                <div class="text-[#00b0f0] font-bold text-sm">Niri Scrollable Wayland</div>
            </div>
            <div class="p-4 rounded-xl border border-white/5 bg-white/[0.01]">
                <div class="text-slate-500 mb-1">DESKTOP SHELL</div>
                <div class="text-white font-bold text-sm">Noctalia Modular</div>
            </div>
            <div class="p-4 rounded-xl border border-white/5 bg-white/[0.01]">
                <div class="text-slate-500 mb-1">TARGET FOCUS</div>
                <div class="text-[#00b0f0] font-bold text-sm">Gaming & Low Latency</div>
            </div>
        </div>
    </section>

    <!-- ARCHITECTURE & FEATURES SECTION -->
    <section id="architecture" class="py-24 md:py-32 scroll-mt-20">
        <div class="max-w-6xl mx-auto px-6">
            
            <div class="text-center mb-20">
                <span class="font-mono text-xs font-bold uppercase tracking-widest text-[#00b0f0] bg-[#00b0f0]/10 px-3.5 py-1.5 rounded-full border border-[#00b0f0]/20">
                    Built With Purpose
                </span>
                <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mt-5 mb-4">
                    Next-Generation Linux Desktop
                </h2>
                <p class="text-slate-400 max-w-2xl mx-auto text-base">
                    VeloxOS combines low-latency system optimizations with a modern, declarative architecture.
                </p>
            </div>

            <!-- Feature Cards Grid -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                
                <!-- Card 1 -->
                <div class="p-8 rounded-2xl border border-white/[0.08] bg-gradient-to-b from-white/[0.03] to-transparent backdrop-blur-md transition-all duration-300 hover:border-[#00b0f0]/40 hover:shadow-[0_10px_30px_rgba(0,176,240,0.1)] group">
                    <div class="w-12 h-12 rounded-xl bg-[#00b0f0]/10 border border-[#00b0f0]/20 text-[#00b0f0] flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path></svg>
                    </div>
                    <div class="flex items-center justify-between mb-3">
                        <h3 class="text-xl font-bold text-white">Extreme Responsiveness</h3>
                        <span class="font-mono text-xs text-[#00b0f0]">01</span>
                    </div>
                    <p class="text-slate-400 text-sm leading-relaxed">
                        Custom kernel tweaks, low-latency task scheduling, and minimal background overhead ensure every frame and keypress counts.
                    </p>
                </div>

                <!-- Card 2 -->
                <div class="p-8 rounded-2xl border border-white/[0.08] bg-gradient-to-b from-white/[0.03] to-transparent backdrop-blur-md transition-all duration-300 hover:border-[#00b0f0]/40 hover:shadow-[0_10px_30px_rgba(0,176,240,0.1)] group">
                    <div class="w-12 h-12 rounded-xl bg-[#00b0f0]/10 border border-[#00b0f0]/20 text-[#00b0f0] flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 11h4M8 9v4m10-3h.01M15 13h.01M17 11h.01M15 9h.01M2 12c0 3.5 2.5 6 6 6 1.2 0 2.3-.3 3.2-.9l1.8 1.8c.4.4 1 .4 1.4 0l1.8-1.8c.6.9 1.7 1.2 3.2 1.2 3.5 0 6-2.5 6-6s-2.5-6-6-6c-1.5 0-2.6.3-3.2 1.2L14.4 5.7c-.4-.4-1-.4-1.4 0L11.2 7.5C10.3 6.9 9.2 6.6 8 6.6c-3.5 0-6 2.5-6 6z"></path></svg>
                    </div>
                    <div class="flex items-center justify-between mb-3">
                        <h3 class="text-xl font-bold text-white">Pro Gaming Stack</h3>
                        <span class="font-mono text-xs text-[#00b0f0]">02</span>
                    </div>
                    <p class="text-slate-400 text-sm leading-relaxed">
                        Pre-tuned Steam, Proton, Vulkan drivers, and Wayland session optimizations built directly into the core configuration.
                    </p>
                </div>

                <!-- Card 3 -->
                <div class="p-8 rounded-2xl border border-white/[0.08] bg-gradient-to-b from-white/[0.03] to-transparent backdrop-blur-md transition-all duration-300 hover:border-[#00b0f0]/40 hover:shadow-[0_10px_30px_rgba(0,176,240,0.1)] group">
                    <div class="w-12 h-12 rounded-xl bg-[#00b0f0]/10 border border-[#00b0f0]/20 text-[#00b0f0] flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                    </div>
                    <div class="flex items-center justify-between mb-3">
                        <h3 class="text-xl font-bold text-white">Reproducible Declarative</h3>
                        <span class="font-mono text-xs text-[#00b0f0]">03</span>
                    </div>
                    <p class="text-slate-400 text-sm leading-relaxed">
                        Powered by Nix Flakes. Your environment stays perfectly reproducible, rollbacks are instant, and state corruption is impossible.
                    </p>
                </div>

            </div>

        </div>
    </section>

    <!-- STATUS / REBOOT MODAL -->
    <div id="statusModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-xl opacity-0 pointer-events-none transition-opacity duration-300">
        <div class="relative w-full max-w-lg bg-[#080d16] border border-white/10 rounded-2xl p-6 sm:p-8 shadow-2xl scale-95 transition-transform duration-300" id="statusModalContent">
            
            <!-- Close Trigger -->
            <button id="closeStatusModal" class="absolute top-5 right-5 text-slate-400 hover:text-white p-1 transition-colors" aria-label="Close">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12"></path></svg>
            </button>

            <!-- Modal Header -->
            <div class="flex items-center gap-3.5 mb-5">
                <div class="w-10 h-10 rounded-xl bg-[#00b0f0]/10 border border-[#00b0f0]/30 text-[#00b0f0] flex items-center justify-center flex-shrink-0">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                </div>
                <div>
                    <h3 class="text-xl font-bold text-white">VeloxOS Project Reboot</h3>
                    <p class="font-mono text-xs text-[#00b0f0]">Status: Under Active Restructuring</p>
                </div>
            </div>

            <p class="text-sm text-slate-300 mb-6 leading-relaxed">
                We are completely restructuring VeloxOS to build on NixOS and Niri. Because of this architectural shift, <strong class="text-white">no public ISO builds are available at this moment</strong>.
            </p>

            <!-- Community / Dev Channels -->
            <div class="flex flex-col gap-3">
                <a 
                    href="https://discord.gg/pgHSK8NGxG" 
                    target="_blank" 
                    class="flex items-center justify-between p-4 rounded-xl border border-white/10 bg-white/[0.02] hover:border-[#00b0f0] transition-colors group"
                >
                    <div class="flex items-center gap-3.5">
                        <svg width="20" height="20" fill="currentColor" class="text-slate-300 group-hover:text-[#00b0f0] transition-colors" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.006 14.006 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
                        <div>
                            <div class="text-sm font-semibold text-white group-hover:text-[#00b0f0] transition-colors">Join Discord Community</div>
                            <div class="text-xs text-slate-400">Dev updates, test builds & chat</div>
                        </div>
                    </div>
                    <span class="font-mono text-xs font-semibold px-2.5 py-1 rounded bg-[#00b0f0]/10 text-[#00b0f0]">Community</span>
                </a>

                <a 
                    href="https://github.com/VeloxOSLinux" 
                    target="_blank" 
                    class="flex items-center justify-between p-4 rounded-xl border border-white/10 bg-white/[0.02] hover:border-[#00b0f0] transition-colors group"
                >
                    <div class="flex items-center gap-3.5">
                        <svg width="20" height="20" fill="currentColor" class="text-slate-300 group-hover:text-[#00b0f0] transition-colors" viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
                        <div>
                            <div class="text-sm font-semibold text-white group-hover:text-[#00b0f0] transition-colors">GitHub Repository</div>
                            <div class="text-xs text-slate-400">Track Nix Flakes & commits</div>
                        </div>
                    </div>
                    <span class="font-mono text-xs font-semibold px-2.5 py-1 rounded bg-white/10 text-slate-300">Code</span>
                </a>
            </div>

            <div class="mt-6 text-center">
                <button id="closeStatusModalBtn" class="text-xs text-slate-400 hover:text-white underline">
                    Close Window
                </button>
            </div>

        </div>
    </div>

    <!-- Modal Script Integration -->
    <script is:inline>
        const setupModal = () => {
            const openBtn = document.getElementById('openStatusModal');
            const closeBtn = document.getElementById('closeStatusModal');
            const closeBtnSecondary = document.getElementById('closeStatusModalBtn');
            const modal = document.getElementById('statusModal');
            const modalContent = document.getElementById('statusModalContent');

            if (!openBtn || !modal) return;

            const openModal = () => {
                modal.classList.remove('opacity-0', 'pointer-events-none');
                modalContent?.classList.remove('scale-95');
                modalContent?.classList.add('scale-100');
            };

            const closeModal = () => {
                modal.classList.add('opacity-0', 'pointer-events-none');
                modalContent?.classList.remove('scale-100');
                modalContent?.classList.add('scale-95');
            };

            openBtn.onclick = openModal;
            closeBtn.onclick = closeModal;
            closeBtnSecondary.onclick = closeModal;

            modal.onclick = (e) => {
                if (e.target === modal) closeModal();
            };
        };

        setupModal();
        document.addEventListener('astro:after-swap', setupModal);
    </script>
</MainLayout>
